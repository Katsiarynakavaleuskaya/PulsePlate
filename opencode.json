{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "pulseplate-chatgpt": {
      "type": "local",
      "command": [
        ".venv/bin/python",
        "mcp_pulseplate_server.py"
      ],
      "enabled": true,
      "environment": {
        "OPENAI_API_KEY": "{env:OPENAI_API_KEY}"
      }
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:FIGMA_ACCESS_TOKEN}"
      },
      "oauth": false
    },
    "cloudflare": {
      "type": "local",
      "command": ["npx", "-y", "@cloudflare/mcp-server-cloudflare"],
      "enabled": false
    }
  }
}
