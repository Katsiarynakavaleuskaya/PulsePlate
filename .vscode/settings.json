{
  // Make Cursor/VS Code use the local venv by default
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Ensure terminal starts with venv in PATH (non-destructive)
  "terminal.integrated.env.osx": {
    "VIRTUAL_ENV": "${workspaceFolder}/.venv",
    "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
  },
  "terminal.integrated.env.linux": {
    "VIRTUAL_ENV": "${workspaceFolder}/.venv",
    "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
  },
  "terminal.integrated.env.windows": {
    "VIRTUAL_ENV": "${workspaceFolder}\\.venv",
    "Path": "${workspaceFolder}\\.venv\\Scripts;${env:Path}"
  },

  // Optional: define a dedicated terminal profile that prefers the venv
  "terminal.integrated.profiles.osx": {
    "Venv": {
      "path": "zsh",
      "args": ["-l"],
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
      }
    }
  },
  "terminal.integrated.defaultProfile.osx": "Venv",

  // Testing defaults
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],

  // Ruff integration (if extension installed)
  "ruff.enable": true,
  "ruff.lineLength": 100,
  "python.analysis.typeCheckingMode": "off",
  "cSpell.words": [
    "Избыточный",
    "команда",
    "масса",
    "cand",
    "dotenv",
    "gtin",
    "isort",
    "redef",
    "slowapi",
    "tdee"
  ]
}
