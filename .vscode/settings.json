{
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.rulers": [100],

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["-q", "tests"],

  "python.linting.enabled": true,
  "python.linting.flake8Enabled": true,
  "python.linting.pylintEnabled": false,

  "python.analysis.typeCheckingMode": "off",
  "python.analysis.extraPaths": ["app", "core", "tests"],

  "isort.args": ["--profile", "black", "--line-length", "100"],

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "cSpell.words": [
    "Гарантирует",
    "Генерировать",
    "гите",
    "изображение",
    "корневого",
    "ломать",
    "напоминание",
    "персистентности",
    "платного",
    "подключает",
    "премиальных",
    "Сгенерировать",
    "Alertmanager",
    "BMIAPI",
    "nosniff",
    "openssl",
    "pesc",
    "pppull",
    "sanitise",
    "shoplist",
    "urlopen",
    "xdist"
  ],
  "cursorpyright.analysis.extraPaths": [
    "app",
    "core",
    "tests"
  ],
  "cursorpyright.analysis.typeCheckingMode": "basic",
  "editor.tabCompletion": "on",
  "diffEditor.codeLens": true,

  // 🚨 CRITICAL: Memory optimization to prevent 18-20GB usage
  "terminal.integrated.persistentSessionScrollback": 100,
  "terminal.integrated.scrollback": 1000,
  "files.maxMemoryForLargeFilesMB": 2048,
  "search.maxResults": 2000,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.git/logs/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/cache/**": true,
    "**/test_cache/**": true,
    "**/build/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/venv": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/cache": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true
  }
}
