{
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.rulers": [100],

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["-q", "tests"],

  "python.linting.enabled": true,
  "python.linting.flake8Enabled": true,
  "python.linting.pylintEnabled": false,

  "python.analysis.typeCheckingMode": "off",
  "python.analysis.extraPaths": ["app", "core", "tests"],

  "isort.args": ["--profile", "black", "--line-length", "100"],

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "cSpell.enabled": true,
  "cSpell.enabledLanguageIds": [
    "python",
    "markdown",
    "plaintext",
    "shellscript",
    "json",
    "yaml"
  ],
  "cSpell.customDictionaries": {
    "workspace-terms": {
      "name": "workspace-terms",
      "path": "./cspell-workspace.txt",
      "addWords": true
    }
  },
  "cSpell.words": [
    "батчинг",
    "валидатор",
    "Гарантирует",
    "Генерировать",
    "гите",
    "джоб",
    "изображение",
    "корневого",
    "ломать",
    "напоминание",
    "нутриционного",
    "персистентности",
    "платного",
    "подключает",
    "премиальных",
    "ретраями",
    "Сгенерировать",
    "Фолбэк",
    "afunc",
    "Alertmanager",
    "bayesian",
    "BMIAPI",
    "carlo",
    "dragonfruit",
    "fixturenames",
    "nosniff",
    "openssl",
    "pesc",
    "pppull",
    "Prioritise",
    "reprtraceback",
    "sanitise",
    "shoplist",
    "urlopen",
    "xdist"
  ],
  "coderabbit.agentType": "Codex CLI",
  "coderabbit.autoReviewMode": "auto",
  // Note: cursorpyright does not inherit from python.analysis.extraPaths, so both entries are required.
  // python.analysis.extraPaths (line 15) is for Pylance, cursorpyright.analysis.extraPaths is for Cursor's Pyright.
  "cursorpyright.analysis.extraPaths": [
    "app",
    "core",
    "tests"
  ],
  "cursorpyright.analysis.typeCheckingMode": "basic",
  "workbench.editor.wrapTabs": true,
  "workbench.editor.limit.excludeDirty": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.defaultBinaryEditor": "default",
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.autoLockGroups": {
    "default": true,
    "jupyter-notebook": true,
    "repl": true,
    "workbench.editors.gettingStartedInput": true,
    "workbench.editorinputs.searchEditorInput": true,
    "notebookOutputEditor": true,
    "imagePreview.previewEditor": true,
    "vscode.videoPreview": true
  },
  "workbench.editor.alwaysShowEditorActions": true,
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.sharedViewState": true,
  "workbench.editor.scrollToSwitchTabs": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "claudeCodeChat.permissions.yoloMode": true,
  "editor.tabCompletion": "on",
  "diffEditor.codeLens": true,
  "mutableAI.upsell": true,
  "github.copilot.enable": {
    "markdown": true,
    "plaintext": true
  }
}
