[run]
# Measure only first-party sources that our tests exercise.
source =
    app
    core

# Exclude heavy/optional modules and assets from coverage to focus on the
# actively exercised application surface in tests.
omit =
    # Tests and fixtures
    tests/*
    tests_strict/*

    # Data and external assets
    data/*
    external/*
    releases/*
    frontend/*
    scripts/*

    # One-off scripts and local debug helpers
    debug_*.py
    reproduce_issue.py
    example_*.py
    test_*.py
    check_coverage.py
    quick_coverage_check.py
    setup_dev_env.py

    # Optional providers/integrations
    providers/*

    # Background update system and external DB clients
    core/food_apis/*

    # Heavy engines and large feature areas not part of core app flows in tests
    core/menu_engine.py
    core/menu_engine_new.py
    core/recipe_db.py
    core/recipe_db_new.py
    core/recipe_synth.py
    core/product_finder.py
    core/product_varieties.py
    core/food_db.py
    core/food_db_new.py
    core/food_merge.py
    core/food_sources/*
    core/recommendations.py
    core/region_catalog.py
    core/weekly_plan.py
    core/weekly_plan_new.py
    core/plate.py
    core/daily_plate.py
    core/bmi_extras.py
    core/bmi_extras_simple.py
    core/exports.py
    core/exports_simple.py
    core/targets.py
    core/rules_who.py
    core/rules_who_simple.py
    core/lifestage_nutrition.py
    core/meal_i18n.py

    # App submodules not required for core coverage gates in tests
    app/routers/*
    app/services/*
    bmi_visualization.py
    bodyfat.py
    nutrition_core.py
    nutrition_plate.py
    bmi_core.py

[report]
omit =
    tests/*
    tests_strict/*
    data/*
    external/*
    releases/*
    frontend/*
    scripts/*
    debug_*.py
    reproduce_issue.py
    example_*.py
    test_*.py
    check_coverage.py
    quick_coverage_check.py
    setup_dev_env.py
    providers/*
    core/food_apis/*
    core/menu_engine.py
    core/menu_engine_new.py
    core/recipe_db.py
    core/recipe_db_new.py
    core/recipe_synth.py
    core/product_finder.py
    core/product_varieties.py
    core/food_db.py
    core/food_db_new.py
    core/food_merge.py
    core/food_sources/*
    core/recommendations.py
    core/region_catalog.py
    core/weekly_plan.py
    core/weekly_plan_new.py
    core/plate.py
    core/daily_plate.py
    core/bmi_extras.py
    core/bmi_extras_simple.py
    core/exports.py
    core/exports_simple.py
    core/targets.py
    core/rules_who.py
    core/rules_who_simple.py
    core/lifestage_nutrition.py
    core/meal_i18n.py
    app/routers/*
    app/services/*
    bmi_visualization.py
    bodyfat.py
    nutrition_core.py
    nutrition_plate.py
    bmi_core.py

exclude_lines =
    # Type checking and defensive code
    if TYPE_CHECKING:
    pragma: no cover
    if __name__ == .__main__.:
