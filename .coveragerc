[run]
branch = True
source =
    app
    core
omit =
    */tests/*
    example_nutrition_api.py
    quick_coverage_check.py
    quick_coverage_update.py
    check_coverage.py
    check_failing_tests.py
    fix_coverage_tests.py
    setup_env_check.py
    scripts/*.py
    test_setup.py
    test_visualization.py
    test_quick_check.py
    test_patch_verification.py
    tests_strict/*
    */__init__.py

[report]
show_missing = True
skip_covered = False
fail_under = 97

[html]
directory = coverage_html
