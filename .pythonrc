# Настройки для удобной работы
import json
from typing import Dict, List, Any

def pretty_print(obj: Any) -> None:
    """Красивый вывод объектов"""
    if hasattr(obj, 'model_dump'):
        print(json.dumps(obj.model_dump(), indent=2, ensure_ascii=False))
    elif hasattr(obj, '__dict__'):
        print(json.dumps(obj.__dict__, indent=2, ensure_ascii=False))
    else:
        print(json.dumps(obj, indent=2, ensure_ascii=False))

def create_test_profile() -> UserProfile:
    """Создать тестовый профиль пользователя"""
    return UserProfile(
        age=30,
        sex="female",
        weight_kg=65.0,
        height_cm=165.0,
        activity_level="moderate",
        goal="maintenance",
        life_stage="adult"
    )

def create_test_targets(profile: UserProfile = None) -> MicronutrientTargets:
    """Создать тестовые микронутриентные цели"""
    if profile is None:
        profile = create_test_profile()
    return build_micronutrient_targets(profile)

print("🚀 PulsePlate Python Shell готов к работе!")
