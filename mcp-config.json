{
  "mcpServers": {
    "openai": {
      "command": "npx",
      "args": ["-y", "mcp-server-openai@0.0.1", "stdio"],
      "env": {
        "OPENAI_API_KEY": "your_openai_api_key_here"
      }
    },
    "pulseplate": {
      "command": "python",
      "args": ["mcp_pulseplate_server.py"],
      "env": {
        "OPENAI_API_KEY": "your_openai_api_key_here"
      }
    }
  }
}
