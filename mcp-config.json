{
  "mcpServers": {
    "openai": {
      "command": "uvx",
      "args": ["mcp-server-openai==0.1.4"],
      "env": {
        "OPENAI_ADMIN_API_KEY": "replace-me"
      }
    },
    "pulseplate": {
      "command": "python",
      "args": ["mcp_pulseplate_server.py"],
      "env": {
        "OPENAI_API_KEY": "your_openai_api_key_here"
      }
    }
  }
}
