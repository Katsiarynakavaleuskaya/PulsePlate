# Hugging Face Configuration
# For embeddings and specialized AI models

# Hugging Face API Configuration
HUGGINGFACE_API_TOKEN=your_huggingface_token_here
HUGGINGFACE_MODEL=nvidia/llama-embed-nemotron-8b
# SECURITY: Use specific commit hash, not "main" branch
# Get latest commit hash from: https://huggingface.co/nvidia/llama-embed-nemotron-8b/commits/main
HUGGINGFACE_MODEL_REVISION=REPLACE_WITH_ACTUAL_COMMIT_HASH  # Replace with actual commit hash

# Model Configuration
HUGGINGFACE_MAX_LENGTH=512
HUGGINGFACE_BATCH_SIZE=1
HUGGINGFACE_DEVICE=auto  # auto, cpu, cuda, mps

# Rate Limiting (requests per minute)
HUGGINGFACE_RATE_LIMIT=60

# Cache Configuration
HUGGINGFACE_CACHE_DIR=~/.cache/huggingface
HUGGINGFACE_OFFLINE_MODE=false

# Security
# WARNING: trust_remote_code enables arbitrary code execution from model repos
# Only set to true for trusted models in development/controlled environments
# NOT recommended for production without explicit security review
HUGGINGFACE_TRUST_REMOTE_CODE=false

# Usage Tracking
HUGGINGFACE_ENABLE_LOGGING=true
HUGGINGFACE_LOG_LEVEL=INFO
