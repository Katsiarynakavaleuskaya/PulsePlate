# Production AI Configuration - Optimized for cost and quality
# Uses Ollama Cloud + OpenAI for maximum efficiency
#
# IMPORTANT: This is a template file. Do not commit real API keys.
# Set actual values via GitHub Secrets or environment variables.

# Ollama Cloud Configuration
OLLAMA_ENDPOINT=https://ollama.com
# OLLAMA_API_KEY should be set via GitHub Secrets or environment variable
# OLLAMA_API_KEY=${OLLAMA_API_KEY}
OLLAMA_MODEL=llama3:8b

# OpenAI Configuration
# OPENAI_API_KEY should be set via GitHub Secrets or environment variable
# OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-4o-mini

# AI Router Settings
AI_ROUTER_ENABLED=true
AI_FALLBACK_ENABLED=true

# Cost Optimization (Production limits)
# OLLAMA_FREE_LIMIT: number of free requests per day
OLLAMA_FREE_LIMIT=100000
# OPENAI_BUDGET_LIMIT: monthly budget in cents (e.g., 50000 = $500.00)
OPENAI_BUDGET_LIMIT=50000

# =============================================================================
# PRODUCTION MONITORING & ALERTS - CRITICAL FOR COST CONTROL
# =============================================================================
#
# RECOMMENDED TELEMETRY:
# - Daily/weekly usage metrics for OLLAMA and OpenAI API calls
# - Request volume, response times, error rates, and cost per request
# - Track usage patterns by user tier, complexity level, and provider
#
# ALERT THRESHOLDS:
# - OLLAMA: Alert at 80% of OLLAMA_FREE_LIMIT (80,000 requests/day)
# - OpenAI: Alert at 70% of OPENAI_BUDGET_LIMIT ($350/month)
# - Emergency: Alert at 95% of any limit
#
# INTEGRATION POINTS:
# - Metrics: Prometheus/CloudWatch/GCP Monitoring/Azure Monitor
# - Billing: Cloud provider billing alerts, OpenAI usage dashboard
# - Notifications: Slack/email on-call, PagerDuty for critical alerts
#
# AUTOMATED ENFORCEMENT:
# - Implement circuit breakers when limits are exceeded
# - Auto-disable AI router if budget exceeded
# - Daily cost reports and weekly budget reviews
# - Monthly audits of usage patterns and cost optimization
#
# =============================================================================

# Quality Thresholds (Stricter for production)
SIMPLE_QUERY_THRESHOLD=0.8
COMPLEX_QUERY_THRESHOLD=0.2

# Environment
ENVIRONMENT=production
