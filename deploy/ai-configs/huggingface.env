# Hugging Face Configuration
# For embeddings and specialized AI models

# Hugging Face API Configuration
HUGGINGFACE_API_TOKEN=your_huggingface_token_here
HUGGINGFACE_MODEL=nvidia/llama-embed-nemotron-8b

# Model Configuration
HUGGINGFACE_MAX_LENGTH=512
HUGGINGFACE_BATCH_SIZE=1
HUGGINGFACE_DEVICE=auto  # auto, cpu, cuda, mps

# Rate Limiting (requests per minute)
HUGGINGFACE_RATE_LIMIT=60

# Cache Configuration
HUGGINGFACE_CACHE_DIR=~/.cache/huggingface
HUGGINGFACE_OFFLINE_MODE=false

# Security
HUGGINGFACE_TRUST_REMOTE_CODE=true

# Usage Tracking
HUGGINGFACE_ENABLE_LOGGING=true
HUGGINGFACE_LOG_LEVEL=INFO
