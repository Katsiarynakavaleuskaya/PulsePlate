# Hybrid AI Configuration - Smart routing between Ollama and OpenAI
# This configuration optimizes cost while maintaining quality

# Ollama Configuration
# Note: OLLAMA_API_KEY may be empty for local development
# Set via secure environment management for production deployments
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3:8b

# OpenAI Configuration
# SECURITY WARNING: Do not commit real API keys to version control!
# Set this value via secure environment management or CI secrets
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# AI Router Settings
AI_ROUTER_ENABLED=true
AI_FALLBACK_ENABLED=true

# Cost Optimization
# OLLAMA_FREE_LIMIT: Maximum number of requests to Ollama before throttling
OLLAMA_FREE_LIMIT=1000
# OPENAI_BUDGET_LIMIT: Maximum cost in cents ($100.00) for OpenAI requests
OPENAI_BUDGET_LIMIT=10000

# Quality Thresholds
# SIMPLE_QUERY_THRESHOLD: model-computed complexity score (0.0-1.0) where higher = more complex
# Routes queries with score <= 0.3 to simple processing (Ollama)
# Tuning: increase to route more queries as simple
SIMPLE_QUERY_THRESHOLD=0.3
# COMPLEX_QUERY_THRESHOLD: model-computed complexity score (0.0-1.0) where higher = more complex
# Routes queries with score >= 0.7 to complex processing (OpenAI)
# Tuning: decrease to be more conservative with OpenAI usage
COMPLEX_QUERY_THRESHOLD=0.7
# Note: Medium range (0.3-0.7) uses fallback/default provider

# Environment
ENVIRONMENT=staging
