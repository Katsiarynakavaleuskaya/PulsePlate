# Local Ollama configuration (runtime env file)
# Copy of local.env.example with optional overrides for local development.

# Local Ollama endpoint
OLLAMA_ENDPOINT=http://host.docker.internal:11434

# Model to use - PINNED for consistency with production
OLLAMA_MODEL=llama3:8b

# Optional: uncomment and set if you need to test authenticated Ollama Cloud access locally
# OLLAMA_API_KEY=replace_with_local_or_test_key

# Environment
ENVIRONMENT=staging
