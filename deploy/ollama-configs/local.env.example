# Local Ollama Configuration
# Use this for local development and staging

# Local Ollama endpoint
# NOTE: host.docker.internal works on Docker Desktop (macOS/Windows) but NOT on Linux
# Linux alternatives:
# 1. Use --network=host and set OLLAMA_ENDPOINT=http://127.0.0.1:11434
# 2. Replace host.docker.internal with your host IP: OLLAMA_ENDPOINT=http://HOST_IP:11434
# 3. Use docker run --add-host=host.docker.internal:HOST_IP to map the hostname
OLLAMA_ENDPOINT=http://host.docker.internal:11434

# Model to use - PINNED for consistency with production
# Using llama3:8b to match production configuration
OLLAMA_MODEL=llama3:8b

# Environment
ENVIRONMENT=staging
