# Ollama Cloud Configuration
# Use this for production deployments with Ollama Cloud

# Ollama Cloud endpoint (replace with your actual endpoint)
OLLAMA_ENDPOINT=https://ollama.com

# API Key for Ollama Cloud (set in GitHub Secrets)
# OLLAMA_API_KEY=your_api_key_here

# Model to use - PINNED for production stability
# Using llama3:8b for optimal balance of quality and performance for iOS app
# NOTE: Consider upgrading to llama-embed-nemotron:8b for better multilingual embeddings
# To update: test new version thoroughly, then update this pin deliberately
OLLAMA_MODEL=llama3:8b

# Environment
ENVIRONMENT=production
