www.{$PRODUCTION_DOMAIN} {
    # RU: `www` должен выпускать сертификат и всегда редиректить на apex.
    # EN: `www` must terminate TLS and permanently redirect to apex.
    redir https://{$PRODUCTION_DOMAIN}{uri} permanent
}

{$PRODUCTION_DOMAIN} {
    encode gzip
    reverse_proxy app:8000

    # RU: Безопасные заголовки по умолчанию (дополняет Cloudflare)
    # EN: Basic security headers (complements Cloudflare)
    header {
        # HSTS уже настроен в Cloudflare, но дублируем на origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # CSP is now set by application middleware with nonce-based security
        # Remove CSP from Caddyfile to allow application to control it
        # Expanded CSP: nonce-based approach (set by app.py csp_nonce_middleware)
        # Application generates per-request nonces and sets CSP header dynamically
        # Permissions-Policy: отключаем неиспользуемые браузерные функции для снижения поверхности атаки
        # Permissions-Policy: disable unused browser features to reduce attack surface
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), autoplay=(), encrypted-media=(), fullscreen=(self), picture-in-picture=()"
    }
}

# RU: Fallback staging hostname для build-only режима, когда staging deploy отключён
# EN: Fallback staging hostname for build-only mode when staging deploy is disabled
{$STAGING_FALLBACK_DOMAIN:pulseplate-staging.duckdns.org} {
    encode gzip
    reverse_proxy app:8000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), autoplay=(), encrypted-media=(), fullscreen=(self), picture-in-picture=()"
    }
}
