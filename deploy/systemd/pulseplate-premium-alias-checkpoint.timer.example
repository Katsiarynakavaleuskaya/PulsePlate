# Delivered disabled; installation and activation require separate monitoring approval.
[Unit]
Description=PulsePlate daily premium alias checkpoint timer

[Timer]
OnCalendar=*-*-* 04:15:00 UTC
Unit=pulseplate-premium-alias-checkpoint.service
Persistent=true
AccuracySec=1min
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
