# Generic self-hosted production example; adjust the selected project/env paths.
# Install as /etc/systemd/system/pulseplate-postgres-backup.service.
# Staging uses the separate pulseplate-staging-postgres-backup.service.example.

[Unit]
Description=PulsePlate Postgres backup (host script + compose exec)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/pulseplate/deploy
EnvironmentFile=/srv/pulseplate/deploy/.env
Environment=PROJECT_DIR=/srv/pulseplate/deploy
Environment=ENV_FILE=/srv/pulseplate/deploy/.env
Environment=COMPOSE_FILE=docker-compose.production.selfhosted.yaml
Environment=BACKUP_DIR=/srv/pulseplate/deploy/backups
ExecStart=/usr/bin/bash /srv/pulseplate/scripts/ops/postgres_backup.sh

[Install]
WantedBy=multi-user.target
