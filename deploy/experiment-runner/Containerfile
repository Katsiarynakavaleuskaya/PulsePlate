    test "${rpm_query_output}" = \
      'procps-ng-4.0.4-11.el10'; \
    expected_rpm_package_count='130'; \
    expected_rpm_inventory_sha256='939bb657:bf29ee0c:83139adb:ffa1880e:710ad991:0836ad2e:88a54f67:68bed2c5'; \
    expected_rpm_inventory_sha256="$(printf '%s' "${expected_rpm_inventory_sha256}" | tr -d ':')"; \
    rpm_inventory="$(rpm -qa --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH} %{SHA256HEADER} %{PAYLOADDIGEST} %{PAYLOADDIGESTALGO}\n')"; \
    rpm_inventory="$(printf '%s\n' "${rpm_inventory}" | LC_ALL=C sort)"; \
    test "$(printf '%s\n' "${rpm_inventory}" | wc -l | tr -d ' ')" = \
      "${expected_rpm_package_count}"; \
    test "$(printf '%s\n' "${rpm_inventory}" | sha256sum | cut -d ' ' -f 1)" = \
      "${expected_rpm_inventory_sha256}"; \
    test -x /usr/bin/git; \
    test -x /usr/bin/make; \
    test -x /usr/bin/unshare; \
    test -f /usr/bin/ps; \
    test ! -L /usr/bin/ps; \
    test -x /bin/ps; \
    groupadd --gid 65532 runner; \
    useradd --uid 65532 --gid 65532 --no-create-home \
      --home-dir /tmp --shell /sbin/nologin runner; \
    mkdir -p /repo/artifacts/orchestration/experiments/results; \
    chown -R 65532:65532 /repo

# Positively guard the known inherited seed before retiring bootstrap capability.
# This expected identity is not a fresh native observation or a build admission.
RUN --network=none python3.13 -I - <<'RETIRE_SEED_PY'
import hashlib
import shutil
import stat
from pathlib import Path

seed_dir = Path("/usr/share/python3.13-wheels")
seed = seed_dir / "pip-25.1.1-py3-none-any.whl"
ensurepip = Path("/usr/lib64/python3.13/ensurepip")
if seed_dir.is_symlink() or not seed_dir.is_dir():
    raise SystemExit("bootstrap_seed_directory_invalid")
if list(seed_dir.iterdir()) != [seed]:
    raise SystemExit("bootstrap_seed_membership_invalid")
info = seed.lstat()
if not stat.S_ISREG(info.st_mode) or info.st_size != 1303656:
    raise SystemExit("bootstrap_seed_file_invalid")
if hashlib.sha256(seed.read_bytes()).hexdigest() != "2cc72b63ce38c42dffda258ccbbf737381ec0bcdc3deaa65746c459600a99936":
    raise SystemExit("bootstrap_seed_digest_invalid")
if ensurepip.is_symlink() or not ensurepip.is_dir():
    raise SystemExit("ensurepip_tree_invalid")
seed.unlink()
shutil.rmtree(ensurepip)
if list(seed_dir.iterdir()) or ensurepip.exists() or ensurepip.is_symlink():
    raise SystemExit("bootstrap_retirement_incomplete")
print("inherited_seed_and_full_ensurepip_retired")
RETIRE_SEED_PY

COPY --from=builder /usr/local/lib/ /usr/local/lib/
COPY --from=builder /usr/local/share/doc/pulseplate-native/ /usr/local/share/doc/pulseplate-native/

