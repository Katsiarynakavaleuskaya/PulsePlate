# syntax=docker/dockerfile:1.7

ARG RUNNER_BASE="registry.access.redhat.com/ubi10/ubi-minimal@sha256:04140c8d78c6c6915b5c1fdad2f16d10eac3630c3339999ccdf659d8c903be50"

FROM scratch AS verified-sources

ADD --checksum=sha256:de390fc168eae5ab2852e9e93d34a0b9ddf05cf9ce90ee28d97de26a4b1f6b93 \
    https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-10 \
    /verified/RPM-GPG-KEY-EPEL-10
ADD --checksum=sha256:8ff46bb59651203a801759627c8c1829c6fe610e031f93c83747ba0832bb97ed \
    https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm \
    /verified/epel-release-latest-10.noarch.rpm
ADD --checksum=sha256:4274e9112adf3fa57c7f9afa7c9b5c631456b18b7403cc627cc5027d02cdd2ae \
    https://raw.githubusercontent.com/python/cpython/7933f4bf7131aa4140750f9404f5de0aa2969ced/Lib/html/parser.py \
    /verified/html-parser.py

FROM ${RUNNER_BASE} AS python-runtime

RUN --mount=type=bind,from=verified-sources,source=/verified,target=/run/verified \
    set -eu; \
    rpm --import /run/verified/RPM-GPG-KEY-EPEL-10; \
    signature_output="$(rpm -Kv /run/verified/epel-release-latest-10.noarch.rpm)"; \
    printf '%s\n' "${signature_output}" | grep -Fq 'key ID e37ed158: OK'; \
    rpm -i /run/verified/epel-release-latest-10.noarch.rpm; \
    rpm_query_output="$(rpm -q --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' epel-release)"; \
    test "${rpm_query_output}" = \
      'epel-release-10-8.el10_2.noarch'; \
    microdnf install -y --setopt=install_weak_deps=0 \
      python3.13-3.13.16-1.el10_2; \
    microdnf clean all; \
    rpm_query_output="$(rpm -q --qf '%{NAME}-%{VERSION}-%{RELEASE}\n' python3.13)"; \
    test "${rpm_query_output}" = \
      'python3.13-3.13.16-1.el10_2'; \
    install -m 0644 /run/verified/html-parser.py \
      /usr/lib64/python3.13/html/parser.py; \
    rm -rf /usr/lib64/python3.13/html/__pycache__; \
    python3.13 -c 'from pathlib import Path; assert Path("/run/verified/html-parser.py").read_bytes() == Path("/usr/lib64/python3.13/html/parser.py").read_bytes()'; \
    python3.13 -c 'from html.parser import HTMLParser; parser = HTMLParser(); assert parser._pending == []; assert parser._pending_len == 0; assert parser._parse_threshold == 1'; \
    expected_rpm_package_count='107'; \
    expected_rpm_inventory_sha256='ca9d7e7d:6aecf2f0:b49e8ce6:fa562a85:42f458c5:48920ccd:126c86da:f40cf8b9'; \
    expected_rpm_inventory_sha256="$(printf '%s' "${expected_rpm_inventory_sha256}" | tr -d ':')"; \
    rpm_inventory="$(rpm -qa --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH} %{SHA256HEADER} %{PAYLOADDIGEST} %{PAYLOADDIGESTALGO}\n')"; \
    rpm_inventory="$(printf '%s\n' "${rpm_inventory}" | LC_ALL=C sort)"; \
    test "$(printf '%s\n' "${rpm_inventory}" | wc -l | tr -d ' ')" = \
      "${expected_rpm_package_count}"; \
    test "$(printf '%s\n' "${rpm_inventory}" | sha256sum | cut -d ' ' -f 1)" = \
      "${expected_rpm_inventory_sha256}"

# Bind the existing UBI trustbundle before any replacement SDK library is loaded.
# These are native build observations; later final-user loaded-library and TLS
# qualification still has to confirm the actual successor image.
RUN python3.13 -I - <<'TRUST_PY'
import hashlib, json
from pathlib import Path
import ssl
paths = ssl.get_default_verify_paths()
if not paths.cafile:
    raise SystemExit("UBI default CA file is unavailable")
original = Path(paths.cafile).resolve(strict=True)
payload = original.read_bytes()
if not original.is_file() or not payload:
    raise SystemExit("UBI default CA file is not a nonempty regular file")
compiled_defaults = Path("/usr/lib/ssl")
if compiled_defaults.is_symlink():
    raise SystemExit("SDK default trust directory is unexpectedly linked")
compiled_defaults.mkdir(exist_ok=True)
for name, source in (("cert.pem", original), ("certs", Path(paths.capath).resolve(strict=True) if paths.capath else None)):
    if source is None:
        continue
    target = compiled_defaults / name
    if target.exists() or target.is_symlink():
        if target.resolve(strict=True) != source:
            raise SystemExit("SDK default trust path conflicts with existing UBI trust")
    else:
        target.symlink_to(source)
print(json.dumps({"ubi_default_cafile": str(original), "bytes": len(payload), "sha256": hashlib.sha256(payload).hexdigest(), "sdk_default_cafile": "/usr/lib/ssl/cert.pem"}, sort_keys=True))
TRUST_PY

FROM python-runtime AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_PYTHON_VERSION_WARNING=1

RUN set -eu; \
    microdnf install -y --setopt=install_weak_deps=0 \
      python3.13-pip-25.1.1-1.el10_1; \
    microdnf clean all; \
    rpm_query_output="$(rpm -q --qf '%{NAME}-%{VERSION}-%{RELEASE}\n' python3.13-pip)"; \
    test "${rpm_query_output}" = \
      'python3.13-pip-25.1.1-1.el10_1'; \
    expected_rpm_package_count='108'; \
    expected_rpm_inventory_sha256='485f2a7e:91850f39:662acff6:c97ad12e:321c377e:3c40f404:a91b9172:a6e10175'; \
    expected_rpm_inventory_sha256="$(printf '%s' "${expected_rpm_inventory_sha256}" | tr -d ':')"; \
    rpm_inventory="$(rpm -qa --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH} %{SHA256HEADER} %{PAYLOADDIGEST} %{PAYLOADDIGESTALGO}\n')"; \
    rpm_inventory="$(printf '%s\n' "${rpm_inventory}" | LC_ALL=C sort)"; \
    test "$(printf '%s\n' "${rpm_inventory}" | wc -l | tr -d ' ')" = \
      "${expected_rpm_package_count}"; \
    test "$(printf '%s\n' "${rpm_inventory}" | sha256sum | cut -d ' ' -f 1)" = \
      "${expected_rpm_inventory_sha256}"; \
    python3.13 -m venv /opt/venv

COPY requirements-lock.txt constraints.txt /build/
COPY scripts/ci/check_python_startup_hooks.py \
     scripts/ci/emergency_python_wheels.json \
     scripts/ci/install_locked_python_requirements.py \
     scripts/ci/check_private_python_proxy_health.py \
     /build/scripts/ci/
COPY tests/fixtures/dependency_security_schema.json /build/tests/fixtures/
COPY sdk-inputs/psycopg-sdk/ /opt/psycopg-sdk/
# Static SDK wheel/receipt only; no supplied DSO/provider/config is active here.
RUN --mount=type=tmpfs,target=/run/acquisition \
    --mount=type=secret,id=pp_py_index,required=true \
    --mount=type=secret,id=pp_py_host,required=false \
    --mount=type=secret,id=pp_netrc,required=false \
    set -eu; \
    set +x; umask 077; \
    home=/run/acquisition/home; temporary=/run/acquisition/tmp; cache=/run/acquisition/cache; \
    owned_home=0; owned_temporary=0; owned_cache=0; \
    cleanup_acquisition() { \
      primary=$?; trap - EXIT INT TERM; cleanup=0; \
      for pair in "$owned_home:$home" "$owned_temporary:$temporary" "$owned_cache:$cache"; do \
        owned=${pair%%:*}; directory=${pair#*:}; \
        if [ "$owned" = 1 ]; then \
          if [ -L "$directory" ] || [ ! -d "$directory" ]; then cleanup=1; \
          elif ! rm -rf -- "$directory"; then cleanup=1; fi; \
          if [ -e "$directory" ] || [ -L "$directory" ]; then cleanup=1; fi; \
        fi; \
      done; \
      printf 'PP_SDK_ACQUISITION_STATUS primary=%s cleanup=%s\n' "$primary" "$cleanup"; \
      if [ "$primary" -ne 0 ]; then exit "$primary"; fi; \
      if [ "$cleanup" -ne 0 ]; then exit 1; fi; \
    }; \
    trap cleanup_acquisition EXIT; trap 'exit 130' INT; trap 'exit 143' TERM; \
    for directory in "$home" "$temporary" "$cache"; do test ! -e "$directory"; test ! -L "$directory"; done; \
    mkdir -m 700 "$home"; owned_home=1; \
    mkdir -m 700 "$temporary"; owned_temporary=1; \
    mkdir -m 700 "$cache"; owned_cache=1; \
    index_url="$(cat /run/secrets/pp_py_index)"; trusted_host=""; \
    if [ -f /run/secrets/pp_py_host ]; then trusted_host="$(cat /run/secrets/pp_py_host)"; fi; \
    if [ -f /run/secrets/pp_netrc ]; then install -m 0600 /run/secrets/pp_netrc "$home/.netrc"; fi; \
    if [ -n "${trusted_host}" ]; then \
      /usr/bin/env -i HOME="$home" TMPDIR="$temporary" XDG_CACHE_HOME="$cache" PIP_CACHE_DIR="$cache/pip" \
        PATH=/usr/bin:/bin LANG=C.UTF-8 PIP_CONFIG_FILE=/dev/null PIP_NO_CACHE_DIR=1 \
        PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1 \
        /opt/venv/bin/python /build/scripts/ci/install_locked_python_requirements.py \
        --python-executable /opt/venv/bin/python \
        --requirements-file /build/requirements-lock.txt --constraints-file /build/constraints.txt \
        --guard-script /build/scripts/ci/check_python_startup_hooks.py \
        --emergency-wheel-manifest /build/scripts/ci/emergency_python_wheels.json \
        --psycopg-sdk /opt/psycopg-sdk --require-virtualenv \
        --upgrade-pip --upgrade-pip-spec 'pip>=26.2,<27' \
        --prefetch-only --wheelhouse-dir /build/wheelhouse \
        --index-url "${index_url}" --trusted-host "${trusted_host}"; \
    else \
      /usr/bin/env -i HOME="$home" TMPDIR="$temporary" XDG_CACHE_HOME="$cache" PIP_CACHE_DIR="$cache/pip" \
        PATH=/usr/bin:/bin LANG=C.UTF-8 PIP_CONFIG_FILE=/dev/null PIP_NO_CACHE_DIR=1 \
        PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1 \
        /opt/venv/bin/python /build/scripts/ci/install_locked_python_requirements.py \
        --python-executable /opt/venv/bin/python \
        --requirements-file /build/requirements-lock.txt --constraints-file /build/constraints.txt \
        --guard-script /build/scripts/ci/check_python_startup_hooks.py \
        --emergency-wheel-manifest /build/scripts/ci/emergency_python_wheels.json \
        --psycopg-sdk /opt/psycopg-sdk --require-virtualenv \
        --upgrade-pip --upgrade-pip-spec 'pip>=26.2,<27' \
        --prefetch-only --wheelhouse-dir /build/wheelhouse --index-url "${index_url}"; \
    fi

# Quarantine is not a loader/provider/config search location. No secret mounts.
COPY sdk-inputs/usr/local/lib/ /opt/sdk-quarantine/usr/local/lib/
COPY sdk-inputs/usr/local/share/doc/pulseplate-native/ /opt/sdk-quarantine/usr/local/share/doc/pulseplate-native/
RUN --network=none set -eu; \
    for path in /run/acquisition/home /run/acquisition/tmp /run/acquisition/cache /run/secrets/pp_py_index /run/secrets/pp_py_host /run/secrets/pp_netrc; do \
      test ! -e "$path"; test ! -L "$path"; \
    done; \
    /usr/bin/env -i HOME=/tmp PATH=/usr/bin:/bin LANG=C.UTF-8 PYTHONDONTWRITEBYTECODE=1 \
      /opt/venv/bin/python -I /build/scripts/ci/install_locked_python_requirements.py \
      --validate-psycopg-sdk --psycopg-sdk /opt/psycopg-sdk --psycopg-native-root /opt/sdk-quarantine

# Finite transport copy only; canonical SDK semantics/origin remain separate.
RUN --network=none /usr/bin/env -i HOME=/tmp PATH=/usr/bin:/bin LANG=C.UTF-8 \
    /opt/venv/bin/python -I - <<'ACTIVATE_NATIVE_PY'
import os, runpy, stat
from pathlib import Path, PurePosixPath
read = runpy.run_path('/build/scripts/ci/install_locked_python_requirements.py', run_name='static_native_copy')['_read_regular_input']
origin = Path('/opt/sdk-quarantine/usr/local')
target = Path('/usr/local')
regular = {'lib/libpq.so.5.18','lib/libssl.so.3','lib/libcrypto.so.3',
           'share/doc/pulseplate-native/OPENSSL-LICENSE','share/doc/pulseplate-native/LIBPQ-COPYRIGHT',
           'share/doc/pulseplate-native/openssl.cnf'}
provider = 'lib/ossl-modules/legacy.so'
if (origin/provider).exists() or (origin/provider).is_symlink(): regular.add(provider)
alias = 'lib/libpq.so.5'
seen = set()
actual_dirs = set()
expected_dirs = {str(parent) for name in regular | {alias} for parent in PurePosixPath(name).parents if str(parent) != '.'}
def discovery_error(error): raise error
for directory, dirs, files in os.walk(origin, followlinks=False, onerror=discovery_error):
    for name in dirs + files:
        path = Path(directory)/name
        info = path.lstat()
        relative = path.relative_to(origin).as_posix()
        if stat.S_ISDIR(info.st_mode): actual_dirs.add(relative)
        else: seen.add(relative)
if seen != regular | {alias} or actual_dirs != expected_dirs:
    raise RuntimeError('Exact qualified native transport membership changed')
if not (origin/alias).is_symlink() or os.readlink(origin/alias) != 'libpq.so.5.18':
    raise RuntimeError('Exact qualified native alias changed')
snapshot = {name:(read(origin/name,maximum=16*1024**2),stat.S_IMODE((origin/name).lstat().st_mode)) for name in regular}
lib = target/'lib'
lib.mkdir(exist_ok=True)
if any(lib.iterdir()): raise RuntimeError('Active native destination is not empty')
for name,(payload,mode) in snapshot.items():
    path = target/name
    path.parent.mkdir(parents=True,exist_ok=True)
    fd = os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,mode)
    with os.fdopen(fd,'wb') as stream: stream.write(payload)
    if read(path,maximum=16*1024**2) != payload or read(origin/name,maximum=16*1024**2) != payload:
        raise RuntimeError('Validated native transport bytes changed during activation')
(target/alias).symlink_to('libpq.so.5.18')
(target/'lib/ossl-modules').mkdir(exist_ok=True)
if os.readlink(target/alias) != os.readlink(origin/alias): raise RuntimeError('Native alias activation changed')
print('PP_SDK_VALIDATED_NATIVE_COPY_COMPLETE')
ACTIVATE_NATIVE_PY

ENV LD_LIBRARY_PATH=/usr/local/lib \
    OPENSSL_CONF=/usr/local/share/doc/pulseplate-native/openssl.cnf
RUN --network=none /usr/bin/env -i HOME=/tmp PATH=/usr/bin:/bin LANG=C.UTF-8 \
    LD_LIBRARY_PATH=/usr/local/lib OPENSSL_CONF=/usr/local/share/doc/pulseplate-native/openssl.cnf \
    PIP_CONFIG_FILE=/dev/null PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1 \
    /opt/venv/bin/python /build/scripts/ci/install_locked_python_requirements.py \
      --python-executable /opt/venv/bin/python --requirements-file /build/requirements-lock.txt \
      --constraints-file /build/constraints.txt --guard-script /build/scripts/ci/check_python_startup_hooks.py \
      --psycopg-sdk /opt/psycopg-sdk --require-virtualenv --consume-only --wheelhouse-dir /build/wheelhouse
RUN --network=none /opt/venv/bin/pip uninstall -y setuptools wheel \
    && chmod -R a+rX /opt/venv

# Keep the original builder usable. ROOT captures complete selected AND retained
# native ownership/payload evidence before admitting any build of this stage.
FROM builder AS runtime-preparation

RUN --network=none /usr/bin/env -i HOME=/tmp PATH=/usr/bin:/bin LANG=C.UTF-8 \
    PIP_CONFIG_FILE=/dev/null PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    /opt/venv/bin/python -m pip uninstall --yes \
      pip-api pip-tools pip-audit virtualenv pre-commit pip
RUN --network=none /opt/venv/bin/python -I - <<'RETIRED_TOOLS_PY'
import importlib.metadata
from importlib.util import find_spec
from pathlib import Path
import re

retired = {"pip", "pip-api", "pip-tools", "pip-audit", "virtualenv", "pre-commit"}
for distribution in importlib.metadata.distributions():
    name = re.sub(r"[-_.]+", "-", distribution.metadata["Name"]).lower()
    if name in retired:
        raise SystemExit("retired distribution remains: " + name)
for module in ("pip", "pip_api", "piptools", "pip_audit", "virtualenv", "pre_commit"):
    if find_spec(module) is not None:
        raise SystemExit("retired module remains: " + module)
    root = Path("/opt/venv/lib/python3.13/site-packages")
    if any((root / leaf).exists() or (root / leaf).is_symlink() for leaf in (module, module + ".py")):
        raise SystemExit("retired physical payload remains: " + module)
for launcher in ("pip", "pip3", "pip3.13", "pip-compile", "pip-sync", "pip-audit", "virtualenv", "pre-commit"):
    path = Path("/opt/venv/bin") / launcher
    if path.exists() or path.is_symlink():
        raise SystemExit("retired launcher remains: " + launcher)
if importlib.metadata.version("build") != "1.5.0":
    raise SystemExit("retained build identity changed")
print("runtime_preparation_selected_tools_absent")
RETIRED_TOOLS_PY

FROM python-runtime AS runner

LABEL org.opencontainers.image.title="PulsePlate Experiment Runner" \
      org.opencontainers.image.description="Strict local oracle execution image" \
      org.opencontainers.image.source="https://github.com/Katsiarynakavaleuskaya/PulsePlate"

COPY --from=runtime-preparation /opt/venv /opt/venv

RUN set -eu; \
    microdnf install -y --setopt=install_weak_deps=0 \
      git-core-2.52.0-1.el10 \
      make-4.4.1-9.el10 \
      shadow-utils-4.15.0-11.el10 \
      util-linux-core-2.40.2-18.el10 \
