{
  "name": "pulseplate-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke:css": "node ./scripts/check-tailwind-utilities.mjs",
    "tokens:build": "node ./scripts/build-tokens.mjs",
    "tokens:check": "node ./scripts/build-tokens.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:ci": "vitest run --environment jsdom --testTimeout=30000 --reporter=verbose --reporter=junit --outputFile=test-results/junit.xml",
    "test:precommit": "vitest run --environment jsdom --testTimeout=30000 --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:accessibility": "vitest run --environment jsdom --testTimeout=30000 --reporter=verbose src/**/__tests__/*Accessibility.test.tsx",
    "test:e2e:doctor": "python3 ../scripts/playwright_mcp.py doctor",
    "test:e2e:install": "python3 ../scripts/playwright_mcp.py install-browser",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "generate-types": "openapi-typescript src/api/openapi.json --output src/api/schema.ts --alphabetize"
  },
  "dependencies": {
    "@capacitor/core": "7.5.0",
    "@capacitor/filesystem": "7.1.8",
    "@capacitor/share": "7.0.4",
    "@headlessui/react": "^2.1.2",
    "@hookform/resolvers": "^3.9.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.5.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^16.0.0",
    "react-is": "^18.3.1",
    "react-router-dom": "7.18.1",
    "recharts": "^3.2.1",
    "tailwind-merge": "^2.4.0",
    "wicg-inert": "^3.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@storybook/addon-docs": "10.4.4",
    "@storybook/react-vite": "10.4.4",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/expect": "4.1.8",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.3",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.6.0",
    "jest-axe": "^10.0.0",
    "jsdom": "29.1.1",
    "msw": "^2.11.3",
    "openapi-typescript": "7.10.1",
    "postcss": "^8.5.10",
    "storybook": "10.4.4",
    "style-dictionary": "5.3.3",
    "tailwindcss": "^3.4.4",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "2.1.3"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.8"
    },
    "dompurify": "3.4.11",
    "esbuild": "0.28.1",
    "js-yaml": "4.2.0",
    "path-to-regexp": "8.4.0",
    "undici": "7.28.0",
    "ws": "8.21.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
