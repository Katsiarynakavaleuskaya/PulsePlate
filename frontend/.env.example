# RU: базовый URL бэкенда (FastAPI). Для Cloudflare Pages переопределите на Worker
# или публичный HTTPS API origin.
# EN: backend base URL (FastAPI). For Cloudflare Pages override this with the Worker
# URL or a public HTTPS API origin.
# Example with Worker proxy:
# VITE_API_BASE=https://pulseplate-api-proxy.<account-subdomain>.workers.dev
# Example with direct public API origin:
# VITE_API_BASE=https://pulseplate.app/api/v1
VITE_API_BASE=http://localhost:8000/api/v1

# Optional: disable analytics for preview/staging environments.
VITE_ANALYTICS_ENABLED=false

# Optional: expose VIP-only web surfaces when the backend/origin is ready.
VITE_VIP_MODULE_ENABLED=false

# Optional: explicit websocket endpoint for HPP live indicator.
# Leave empty unless a websocket-capable public endpoint exists.
VITE_HPP_LIVE_WS_URL=
