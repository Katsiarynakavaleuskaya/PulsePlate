[tool.ruff]
line-length = 100
target-version = "py310"

[tool.ruff.lint]
# Базовый набор правил, без «жёстких» плагинов
select = ["E", "F", "W", "I"]  # pycodestyle/pyflakes/isort

[tool.ruff.lint.isort]
known-first-party = ["app", "bmi_core"]

[tool.pytest.ini_options]
pythonpath = "."
addopts = "-q"
asyncio_mode = "auto"
