class TestUtilityFunctionsCoverage:
    """Test utility functions and edge cases"""

    def test_normalize_flags_edge_cases(self):
        """Test normalize_flags function edge cases"""
        from app import normalize_flags

        # Test with None
        result = normalize_flags(None)
        assert isinstance(result, set)

        # Test with empty list
        result = normalize_flags([])
        assert isinstance(result, set)

        # Test with various flag types
        result = normalize_flags(["vegetarian", "gluten_free"])
        assert isinstance(result, set)

    def test_legacy_category_functions(self):
        """Test legacy category handling"""
        # Test legacy functions if they exist
        try:
            from app import get_legacy_category
            result = get_legacy_category("normal")
            assert isinstance(result, (str, type(None)))
        except ImportError:
            # Function doesn't exist, which is fine
            pass

    def test_vip_module_availability(self):
        """Test VIP module availability checks"""
        # Test VIP module flag
        try:
            from app import VIP_MODULE_ENABLED
            assert isinstance(VIP_MODULE_ENABLED, bool)
        except ImportError:
            # VIP module not available
            pass

class TestComplexEndpointScenarios:
    """Test complex endpoint scenarios for better coverage"""

    def test_bmi_endpoint_all_parameters(self, client):
        """Test BMI endpoint with all possible parameters"""
        response = client.post("/bmi", json={
            "weight_kg": 70,
            "height_cm": 175,
            "age": 30,
            "sex": "male",
            "pregnant": False,
            "athlete": False,
            "waist_cm": 80,
            "neck_cm": 35,
            "hip_cm": 95,
            "bodyfat": 15.5,
            "language": "en"
        })
        assert response.status_code == 200

    def test_plan_endpoint_all_parameters(self, client):
        """Test plan endpoint with all possible parameters"""
        response = client.post("/plan", json={
            "weight_kg": 70,
            "height_cm": 175,
            "age": 30,
            "sex": "male",
            "goal": "lose_weight",
            "activity": "moderate",
            "diet_flags": ["vegetarian"],
            "language": "en",
            "pregnant": False,
            "athlete": False
        })
        assert response.status_code == 200

    def test_endpoints_with_spanish_language(self, client):
        """Test endpoints with Spanish language"""
        # Test BMI with Spanish
        response = client.post("/bmi", json={
            "weight_kg": 70,
            "height_cm": 175,
            "age": 30,
            "sex": "male",
            "language": "es"
        })
        assert response.status_code == 200

        # Test plan with Spanish
        response = client.post("/plan", json={
            "weight_kg": 70,
            "height_cm": 175,
            "age": 30,
            "sex": "male",
            "goal": "lose_weight",
            "activity": "moderate",
            "language": "es"
        })
        assert response.status_code == 200

class TestConfigurationCoverage:
    """Test configuration and environment variable scenarios"""

    def test_environment_variables_coverage(self):
        """Test environment variable handling"""
        import os

        # Test with different environment settings
        original_env = os.environ.copy()

        try:
            # Test VIP module environment variable
            os.environ["VIP_MODULE_ENABLED"] = "true"
            # Import would read this environment variable

            # Test other configuration variables
            os.environ["RATE_LIMITING_ENABLED"] = "true"

            # Verify environment variables are read correctly
            assert os.environ.get("VIP_MODULE_ENABLED") == "true"
            assert os.environ.get("RATE_LIMITING_ENABLED") == "true"

        finally:
            # Restore original environment
            os.environ.clear()
            os.environ.update(original_env)
