        # Тестируем случай когда waist_cm is None
        result = app.waist_risk(None, True, "en")
        assert result == ""

    def test_prometheus_metrics_unavailable(self):
        """Тест metrics endpoint когда prometheus недоступен"""
        # Перезагружаем приложение с prometheus недоступным
        with patch('app.generate_latest', None):
            from app import app as test_app
            client = TestClient(test_app)

            response = client.get("/metrics")
            assert response.status_code == 200
            assert "error" in response.json()
            assert "Prometheus client not available" in response.json()["error"]

    def test_bmi_visualization_not_available_coverage(self):
        """Тест BMI endpoint когда визуализация недоступна"""
        from app import app as test_app
        client = TestClient(test_app)

        # Тест с включенной визуализацией но MATPLOTLIB_AVAILABLE = False
        with patch('app.generate_bmi_visualization', None):
            with patch('app.MATPLOTLIB_AVAILABLE', False):
                data = {
                    "weight_kg": 70.0,
                    "height_m": 1.75,
                    "age": 30,
                    "gender": "male",
                    "pregnant": "no",
                    "athlete": "no",
                    "include_chart": True
                }

                response = client.post("/bmi", json=data)
                assert response.status_code == 200
                result = response.json()
                # Должно быть сообщение об ошибке визуализации
                if "visualization" in result:
                    assert result["visualization"]["available"] is False

    def test_insight_feature_disabled_coverage(self):
        """Тест insight endpoint когда фича отключена"""
        from app import app as test_app
        client = TestClient(test_app)

        with patch.dict(os.environ, {"FEATURE_INSIGHT": "false"}):
            response = client.post("/insight", json={"text": "test"})
            assert response.status_code == 503
            assert "FEATURE_INSIGHT is disabled" in response.json()["detail"]

    def test_insight_llm_module_unavailable_coverage(self):
        """Тест insight endpoint когда LLM модуль недоступен"""
        from app import app as test_app
        client = TestClient(test_app)

        with patch.dict(os.environ, {"FEATURE_INSIGHT": "true"}):
            with patch('builtins.__import__', side_effect=ImportError):
                response = client.post("/insight", json={"text": "test"})
                assert response.status_code == 503
                assert "LLM module is not available" in response.json()["detail"]

    def test_insight_provider_none_coverage(self):
        """Тест insight endpoint когда provider None"""
        from app import app as test_app
        client = TestClient(test_app)

        with patch.dict(os.environ, {"FEATURE_INSIGHT": "true"}):
            with patch('llm.get_provider', return_value=None):
                response = client.post("/insight", json={"text": "test"})
                assert response.status_code == 503
                assert "No LLM provider configured" in response.json()["detail"]

    def test_insight_provider_error_coverage(self):
        """Тест insight endpoint когда provider вызывает ошибку"""
        from app import app as test_app
        client = TestClient(test_app)

        mock_provider = Mock()
        mock_provider.generate.side_effect = Exception("Provider error")

        with patch.dict(os.environ, {"FEATURE_INSIGHT": "true"}):
            with patch('llm.get_provider', return_value=mock_provider):
                response = client.post("/insight", json={"text": "test"})
                assert response.status_code == 503
                assert "LLM provider error" in response.json()["detail"]

    def test_premium_plate_feature_unavailable_coverage(self):
        """Тест premium plate endpoint когда фича недоступна"""
        from app import app as test_app
        client = TestClient(test_app)

        headers = {"X-API-Key": "test_key"}
        data = {
            "sex": "male",
            "age": 30,
            "height_cm": 175,
            "weight_kg": 70,
            "activity": "moderate",
            "goal": "maintain"
        }

        with patch('app.make_plate', None):
            response = client.post("/api/v1/premium/plate", json=data, headers=headers)
            assert response.status_code == 503
            assert "Enhanced plate feature not available" in response.json()["detail"]

