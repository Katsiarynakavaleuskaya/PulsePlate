    def test_vip_module_enabled_true(self):
        """Тест включения VIP модуля"""
        with patch.dict(os.environ, {"VIP_MODULE_ENABLED": "true"}):
            if 'app' in sys.modules:
                del sys.modules['app']
            import app
            # VIP должен быть включен
            assert app.VIP_MODULE_ENABLED is True

    def test_vip_module_enabled_false(self):
        """Тест отключения VIP модуля"""
        with patch.dict(os.environ, {"VIP_MODULE_ENABLED": "false"}, clear=True):
            if 'app' in sys.modules:
                del sys.modules['app']
            import app
            # VIP должен быть отключен
            assert app.VIP_MODULE_ENABLED is False

    def test_rate_limiting_not_available(self):
        """Тест когда rate limiting недоступен"""
        import app

        # Тестируем _is_rate_limiting_available функцию
        with patch('app.slowapi_available', False):
            with patch('app.Limiter', None):
                result = app._is_rate_limiting_available()
                assert result is False

    def test_api_key_missing_coverage(self):
        """Тест API ключа когда переменная окружения не установлена"""
        import app

        # Тестируем случай когда API_KEY не установлен
        with patch.dict(os.environ, {}, clear=True):
            # API key не должен вызывать ошибку если переменная не установлена
            result = app.get_api_key("any_key")
            assert result == "any_key"

    def test_api_key_empty_coverage(self):
        """Тест API ключа когда переменная окружения пустая"""
        import app

        # Тестируем случай когда API_KEY пустой
        with patch.dict(os.environ, {"API_KEY": ""}):
            # Пустой API key не должен вызывать ошибку
            result = app.get_api_key("any_key")
            assert result == "any_key"

    def test_legacy_category_label_exception_coverage(self):
