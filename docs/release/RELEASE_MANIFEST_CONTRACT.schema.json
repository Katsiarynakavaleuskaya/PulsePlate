{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.app/schemas/release-manifest.v1.json",
  "title": "PulsePlate Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hash_algorithm",
    "canonicalization",
    "release_manifest_hash",
    "build_identity",
    "reviewer_identity",
    "ml_identity",
    "supply_chain_identity",
    "release_decision",
    "decision_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": "release-manifest.v1"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "json-sorted-compact-utf8-single-trailing-newline"
    },
    "release_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_sha",
        "ios_build_number",
        "marketing_version",
        "bundle_id"
      ],
      "properties": {
        "git_sha": {
          "type": "string",
          "minLength": 1
        },
        "ios_build_number": {
          "type": "string",
          "minLength": 1
        },
        "marketing_version": {
          "type": "string",
          "minLength": 1
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reviewer_notes_hash",
        "appstore_metadata_hash",
        "source_artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": "release-reviewer-packet-hashes.v1"
        },
        "reviewer_notes_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "appstore_metadata_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_artifact"
          }
        }
      }
    },
    "ml_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "rag_gate_result_hash",
        "eval_artifact_hash",
        "release_decision",
        "source_artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": "release-rag-gate-result.v1"
        },
        "rag_gate_result_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "eval_artifact_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "release_decision": {
          "enum": [
            "PASS",
            "NO-GO"
          ]
        },
        "mlflow_run_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_artifact"
          }
        }
      }
    },
    "supply_chain_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sbom_digest",
        "provenance_digest",
        "attestation_status"
      ],
      "properties": {
        "sbom_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provenance_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "attestation_status": {
          "enum": [
            "VERIFIED",
            "FAILED",
            "MISSING",
            "PENDING"
          ]
        }
      }
    },
    "release_decision": {
      "enum": [
        "ALLOW",
        "BLOCK"
      ]
    },
    "decision_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "hash"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
