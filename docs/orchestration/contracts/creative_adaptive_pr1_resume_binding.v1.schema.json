    "candidateBinding": {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"filename": {"const": "creative_code_candidate.v1.json"}, "artifact_type": {"const": "creative_code_candidate"}, "ref": {"pattern": "^artifacts/orchestration/creative_code/adaptive_pilots/[A-Za-z0-9][A-Za-z0-9._-]*/creative_code_candidate\\.v1\\.json$"}}}]},
    "sourcePacketBinding": {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"filename": {"const": "source_packet.json"}, "artifact_type": {"const": "json"}, "ref": {"pattern": "^artifacts/orchestration/creative_code/adaptive_pilots/[A-Za-z0-9][A-Za-z0-9._-]*/pr1_prepare/source_packet\\.json$"}}}]},
    "variantsBinding": {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"filename": {"const": "variants.json"}, "artifact_type": {"const": "json"}, "ref": {"pattern": "^artifacts/orchestration/creative_code/adaptive_pilots/[A-Za-z0-9][A-Za-z0-9._-]*/pr1_prepare/variants\\.json$"}}}]},
    "reviewsBinding": {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"filename": {"const": "skeptic_reviews.json"}, "artifact_type": {"const": "json"}, "ref": {"pattern": "^artifacts/orchestration/creative_code/adaptive_pilots/[A-Za-z0-9][A-Za-z0-9._-]*/pr1_prepare/skeptic_reviews\\.json$"}}}]},
