  },
  "$defs": {
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["intake_id", "intake_ref", "intake_fingerprint"], "properties": {"intake_id": {"type": "string"}, "intake_ref": {"type": "string", "pattern": "^artifacts/orchestration/creative_code/spec_bridge/evidence:creative_adaptive_pr1_resume_binding:orchestration:1\\.0:[a-f0-9]{24}/creative_adaptive_pr1_variant_intake\\.json$"}, "intake_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
