    "contextBinding": {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"filename": {"const": "context_map.v2.json"}, "artifact_type": {"const": "creative_protocol_context_map"}, "ref": {"pattern": "^artifacts/orchestration/creative_code/adaptive_pilots/[A-Za-z0-9][A-Za-z0-9._-]*/context_map\\.v2\\.json$"}}}]},
