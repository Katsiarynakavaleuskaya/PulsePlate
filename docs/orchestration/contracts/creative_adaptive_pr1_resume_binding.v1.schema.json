    "approvalBinding": {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"filename": {"const": "approval.v2.json"}, "artifact_type": {"const": "creative_hypothesis_approval"}, "ref": {"pattern": "^artifacts/orchestration/creative_code/adaptive_pilots/[A-Za-z0-9][A-Za-z0-9._-]*/approval\\.v2\\.json$"}}}]},
