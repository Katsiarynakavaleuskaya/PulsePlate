{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/creative_code_patch_generation_gate.v1.schema.json",
  "title": "CreativeCodePatchGenerationGate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "policy_version",
    "gate_id",
    "idempotency_key",
    "admission_id",
    "admission_fingerprint",
    "admission_ref",
    "request_id",
    "request_fingerprint",
    "request_ref",
    "source_bundle_id",
    "source_bundle_fingerprint",
    "source_bundle_ref",
    "selected_variant_id",
    "selected_variant_fingerprint",
    "base_commit_sha",
    "run_id",
    "state_fingerprint",
    "budget_limits",
    "allowed_paths_fingerprint",
    "oracle_commands_fingerprint",
    "metrics_fingerprint",
    "immutable_oracles_fingerprint",
    "oracle_command_count",
    "metric_count",
    "immutable_oracle_count",
    "coordinator_advisory_hints_ref",
    "coordinator_advisory_hints_fingerprint",
    "checks",
    "passed_checks",
    "total_checks",
    "next_action",
    "authority",
    "sanitized"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "creative_code_patch_generation_gate" },
    "policy_version": { "const": "creative-code-patch-generation-gate-v1" },
    "gate_id": { "$ref": "#/$defs/safe_id" },
    "idempotency_key": { "$ref": "#/$defs/safe_id" },
    "admission_id": { "$ref": "#/$defs/safe_id" },
    "admission_fingerprint": { "$ref": "#/$defs/sha256" },
    "admission_ref": { "$ref": "#/$defs/json_artifact_ref" },
    "request_id": { "$ref": "#/$defs/safe_id" },
    "request_fingerprint": { "$ref": "#/$defs/sha256" },
    "request_ref": { "$ref": "#/$defs/json_artifact_ref" },
    "source_bundle_id": { "$ref": "#/$defs/safe_id" },
    "source_bundle_fingerprint": { "$ref": "#/$defs/sha256" },
    "source_bundle_ref": { "$ref": "#/$defs/json_artifact_ref" },
    "selected_variant_id": { "$ref": "#/$defs/safe_id" },
    "selected_variant_fingerprint": { "$ref": "#/$defs/sha256" },
    "base_commit_sha": { "$ref": "#/$defs/git_sha" },
    "run_id": { "$ref": "#/$defs/safe_id" },
    "state_fingerprint": { "$ref": "#/$defs/sha256" },
    "budget_limits": { "$ref": "#/$defs/budget_limits" },
    "allowed_paths_fingerprint": { "$ref": "#/$defs/sha256" },
    "oracle_commands_fingerprint": { "$ref": "#/$defs/sha256" },
    "metrics_fingerprint": { "$ref": "#/$defs/sha256" },
    "immutable_oracles_fingerprint": { "$ref": "#/$defs/sha256" },
    "oracle_command_count": { "type": "integer", "minimum": 1, "maximum": 20 },
    "metric_count": { "type": "integer", "minimum": 1, "maximum": 20 },
    "immutable_oracle_count": { "type": "integer", "minimum": 1, "maximum": 20 },
    "coordinator_advisory_hints_ref": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/json_artifact_ref" }]
    },
    "coordinator_advisory_hints_fingerprint": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "checks": { "$ref": "#/$defs/checks" },
    "passed_checks": { "const": 12 },
    "total_checks": { "const": 12 },
    "next_action": { "const": "generate_candidate_then_evaluate_candidate" },
    "authority": { "$ref": "#/$defs/authority" },
    "sanitized": { "const": true }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "json_artifact_ref": {
      "type": "string",
      "pattern": "^(?!/|~|[A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)artifacts/orchestration/creative_code/[A-Za-z0-9._:/-]+\\.json$"
    },
    "budget_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_attempts",
        "generation_timeout_seconds",
        "evaluation_timeout_seconds",
        "max_changed_files",
        "max_diff_lines",
        "max_patch_bytes"
      ],
      "properties": {
        "generation_attempts": { "const": 1 },
        "generation_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "evaluation_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "max_changed_files": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_diff_lines": { "type": "integer", "minimum": 1, "maximum": 800 },
        "max_patch_bytes": { "type": "integer", "minimum": 1, "maximum": 524288 }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_bindings_valid",
        "admission_prepared",
        "run_state_matches_admission",
        "run_artifacts_present",
        "selected_variant_matches_request",
        "base_matches_origin_main",
        "shared_tree_clean",
        "budgets_within_request_contract",
        "immutable_oracles_bound",
        "authority_within_pr2",
        "advisory_hints_non_authoritative",
        "no_preexisting_candidate_artifacts"
      ],
      "properties": {
        "admission_bindings_valid": { "const": true },
        "admission_prepared": { "const": true },
        "run_state_matches_admission": { "const": true },
        "run_artifacts_present": { "const": true },
        "selected_variant_matches_request": { "const": true },
        "base_matches_origin_main": { "const": true },
        "shared_tree_clean": { "const": true },
        "budgets_within_request_contract": { "const": true },
        "immutable_oracles_bound": { "const": true },
        "authority_within_pr2": { "const": true },
        "advisory_hints_non_authoritative": { "const": true },
        "no_preexisting_candidate_artifacts": { "const": true }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emit_local_artifacts",
        "run_patch_builder_evaluate",
        "run_patch_builder_generate",
        "validate_generation_gate",
        "call_arbitrary_network",
        "call_product_runtime",
        "call_provider",
        "claim_merge_readiness",
        "create_branch",
        "edit_fixed_mapping",
        "merge",
        "modify_workflows",
        "open_draft_pr",
        "open_pull_request",
        "post_github_comment",
        "promote_candidate",
        "push_branch",
        "read_secrets",
        "release",
        "resolve_review_threads",
        "slack_github_authority_expansion",
        "use_semantic_cache",
        "write_graph_truth",
        "write_repository",
        "write_shared_worktree"
      ],
      "properties": {
        "emit_local_artifacts": { "const": true },
        "run_patch_builder_evaluate": { "const": true },
        "run_patch_builder_generate": { "const": true },
        "validate_generation_gate": { "const": true },
        "call_arbitrary_network": { "const": false },
        "call_product_runtime": { "const": false },
        "call_provider": { "const": false },
        "claim_merge_readiness": { "const": false },
        "create_branch": { "const": false },
        "edit_fixed_mapping": { "const": false },
        "merge": { "const": false },
        "modify_workflows": { "const": false },
        "open_draft_pr": { "const": false },
        "open_pull_request": { "const": false },
        "post_github_comment": { "const": false },
        "promote_candidate": { "const": false },
        "push_branch": { "const": false },
        "read_secrets": { "const": false },
        "release": { "const": false },
        "resolve_review_threads": { "const": false },
        "slack_github_authority_expansion": { "const": false },
        "use_semantic_cache": { "const": false },
        "write_graph_truth": { "const": false },
        "write_repository": { "const": false },
        "write_shared_worktree": { "const": false }
      }
    }
  }
}
