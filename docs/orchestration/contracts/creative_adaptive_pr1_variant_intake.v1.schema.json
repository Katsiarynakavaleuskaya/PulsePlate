{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative_adaptive_pr1_variant_intake.v1.schema.json",
  "title": "CreativeAdaptivePr1VariantIntakeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "intake_id", "idempotency_key", "policy_version", "pilot_id", "source_candidate", "target_surface", "required_tests", "declarations", "materialized_variants", "equality_proof", "authority", "sanitized"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "creative_adaptive_pr1_variant_intake"},
    "intake_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 160},
    "policy_version": {"const": "creative-adaptive-pr1-resume-v1"},
    "pilot_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "source_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "candidate_ref", "candidate_fingerprint"],
      "properties": {
        "candidate_id": {"type": "string"},
        "candidate_ref": {"type": "string", "pattern": "^artifacts/orchestration/creative_code/adaptive_pilots/[A-Za-z0-9][A-Za-z0-9._-]*/creative_code_candidate\\.v1\\.json$"},
        "candidate_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "target_surface": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"allOf": [{"$ref": "creative_code_specification.v1.schema.json#/$defs/path"}, {"pattern": "^core/(rag|insight)/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[^*?\\[\\]]+\\.py$"}]}},
    "required_tests": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"allOf": [{"$ref": "creative_code_specification.v1.schema.json#/$defs/test_path"}, {"pattern": "^tests/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[^*?\\[\\]]+\\.py$"}]}},
    "declarations": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/declaration"}, {"properties": {"approach_family": {"const": "minimal_surgical_change"}}}]},
        {"allOf": [{"$ref": "#/$defs/declaration"}, {"properties": {"approach_family": {"const": "seam_extraction"}}}]},
        {"allOf": [{"$ref": "#/$defs/declaration"}, {"properties": {"approach_family": {"const": "fail_closed_guard"}}}]},
        {"allOf": [{"$ref": "#/$defs/declaration"}, {"properties": {"approach_family": {"const": "observable_metadata_only"}}}]},
        {"allOf": [{"$ref": "#/$defs/declaration"}, {"properties": {"approach_family": {"const": "test_first_contract_lock"}}}]}
      ],
      "items": false
    },
    "materialized_variants": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "prefixItems": [
        {"allOf": [{"$ref": "creative_code_specification.v1.schema.json#/$defs/variant"}, {"properties": {"approach_family": {"const": "minimal_surgical_change"}}}]},
        {"allOf": [{"$ref": "creative_code_specification.v1.schema.json#/$defs/variant"}, {"properties": {"approach_family": {"const": "seam_extraction"}}}]},
        {"allOf": [{"$ref": "creative_code_specification.v1.schema.json#/$defs/variant"}, {"properties": {"approach_family": {"const": "fail_closed_guard"}}}]},
        {"allOf": [{"$ref": "creative_code_specification.v1.schema.json#/$defs/variant"}, {"properties": {"approach_family": {"const": "observable_metadata_only"}}}]},
        {"allOf": [{"$ref": "creative_code_specification.v1.schema.json#/$defs/variant"}, {"properties": {"approach_family": {"const": "test_first_contract_lock"}}}]}
      ],
      "items": false
    },
    "equality_proof": {
      "type": "object", "additionalProperties": false,
      "required": ["approach_families", "declarations_fingerprint", "materialized_variants_fingerprint", "declaration_count", "variant_count", "equal_count"],
      "properties": {
        "approach_families": {"type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "prefixItems": [{"const": "minimal_surgical_change"}, {"const": "seam_extraction"}, {"const": "fail_closed_guard"}, {"const": "observable_metadata_only"}, {"const": "test_first_contract_lock"}], "items": false},
        "declarations_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "materialized_variants_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "declaration_count": {"type": "integer", "minimum": 3, "maximum": 5},
        "variant_count": {"type": "integer", "minimum": 3, "maximum": 5},
        "equal_count": {"const": true}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["read_sanitized_context", "emit_local_artifacts", "run_specification_prepare", "call_product_runtime", "call_provider", "change_openapi", "claim_merge_readiness", "create_branch", "dispatch_to_agents", "execute_pr2_patch_builder", "execute_pr3_promotion", "finalize_specification_bundle", "generate_candidate_patch", "generate_patch", "merge", "modify_workflows", "open_pr", "push", "read_secrets", "resolve_threads", "use_semantic_cache", "write_branch", "write_graph_truth", "write_repository", "write_shared_worktree"],
      "properties": {
        "read_sanitized_context": {"const": true}, "emit_local_artifacts": {"const": true}, "run_specification_prepare": {"const": true},
        "call_product_runtime": {"const": false}, "call_provider": {"const": false}, "change_openapi": {"const": false}, "claim_merge_readiness": {"const": false}, "create_branch": {"const": false}, "dispatch_to_agents": {"const": false}, "execute_pr2_patch_builder": {"const": false}, "execute_pr3_promotion": {"const": false}, "finalize_specification_bundle": {"const": false}, "generate_candidate_patch": {"const": false}, "generate_patch": {"const": false}, "merge": {"const": false}, "modify_workflows": {"const": false}, "open_pr": {"const": false}, "push": {"const": false}, "read_secrets": {"const": false}, "resolve_threads": {"const": false}, "use_semantic_cache": {"const": false}, "write_branch": {"const": false}, "write_graph_truth": {"const": false}, "write_repository": {"const": false}, "write_shared_worktree": {"const": false}
      }
    },
    "sanitized": {"const": true}
  },
  "$defs": {
    "declaration": {
      "type": "object", "additionalProperties": false,
      "required": ["approach_family", "problem_statement", "implementation_steps", "target_paths", "tests_to_add", "negative_controls", "rollback_plan", "falsifier", "risk_notes", "wellness_boundary", "estimated_changed_files"],
      "properties": {
        "approach_family": {"enum": ["minimal_surgical_change", "seam_extraction", "fail_closed_guard", "observable_metadata_only", "test_first_contract_lock"]},
        "problem_statement": {"$ref": "creative_code_specification.v1.schema.json#/$defs/safe_text"},
        "implementation_steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "creative_code_specification.v1.schema.json#/$defs/safe_text"}},
        "target_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "creative_code_specification.v1.schema.json#/$defs/path"}},
        "tests_to_add": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "creative_code_specification.v1.schema.json#/$defs/test_path"}},
        "negative_controls": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "creative_code_specification.v1.schema.json#/$defs/safe_token"}},
        "rollback_plan": {"$ref": "creative_code_specification.v1.schema.json#/$defs/safe_text"}, "falsifier": {"$ref": "creative_code_specification.v1.schema.json#/$defs/safe_text"},
        "risk_notes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "creative_code_specification.v1.schema.json#/$defs/safe_text"}},
        "wellness_boundary": {"$ref": "creative_code_specification.v1.schema.json#/$defs/safe_text"},
        "estimated_changed_files": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}
