{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/review_invariant_family_relations.v1.schema.json",
  "title": "PulsePlate review invariant family snapshot or relations artifact",
  "type": "object",
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/artifact"
    }
  ],
  "x-pulseplate-policy-projection": {
    "policy_version": "review_invariant_family_relations.policy.v1",
    "schema_versions": {
      "snapshot": "review_invariant_family_snapshot.v1",
      "relations": "review_invariant_family_relations.v1"
    },
    "bounds": {
      "max_stdin_bytes": 1048576,
      "max_stdout_bytes": 1048576,
      "max_stderr_bytes": 4096,
      "max_findings": 2048,
      "max_families": 32,
      "max_memberships": 4096,
      "max_relation_records": 496,
      "max_derived_partition_refs": 2048,
      "max_id_ascii_bytes": 64
    },
    "id_pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_-]{0,62}[A-Za-z0-9])?$",
    "forbidden_id_pattern": "(?:[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Kk][Ee][Yy]|[Aa][KkSs][Ii][Aa]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Bb][Ee][Aa][Rr][Ee][Rr]|[Cc][Ll][Ii][Ee][Nn][Tt][_-]?[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Gg][Hh][PpOoUuSsRr]_|[Gg][Ll][Pp][Aa][Tt]-|[Gg][Ii][Tt][Hh][Uu][Bb][_-]?[Pp][Aa][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Ss][Kk][_-]?(?:[Ll][Ii][Vv][Ee]|[Tt][Ee][Ss][Tt]|[Pp][Rr][Oo][Jj])|[Tt][Oo][Kk][Ee][Nn])",
    "relation_values": [
      "equal",
      "left_proper_subset",
      "right_proper_subset",
      "partial_overlap",
      "disjoint"
    ],
    "authority_fields": [
      "side_effects_allowed",
      "posting_allowed",
      "thread_resolution_allowed",
      "mapping_authority",
      "implementation_authority",
      "approval_authority",
      "review_authority",
      "security_authority",
      "runtime_authority",
      "learning_authority",
      "reflection_authority",
      "kpp_authority",
      "oracle_authority",
      "routing_authority",
      "promotion_authority",
      "merge_authority"
    ],
    "inference_sources_forbidden": [
      "prose",
      "paths",
      "roles",
      "severity",
      "statuses",
      "oracles",
      "learning",
      "reflection",
      "artifacts",
      "providers",
      "similarity"
    ],
    "canonicalization": {
      "json": "ascii_compact_sorted_keys",
      "stdout_terminator": "one_lf",
      "utf8_bom_policy": "reject",
      "numeric_lexeme_policy": "reject_all",
      "membership_source": "explicit_only",
      "pair_order": "family_id_lexicographic",
      "partition_order": "finding_id_lexicographic"
    },
    "digests": {
      "algorithm": "sha256",
      "separator": "nul",
      "snapshot_core_domain": "pulseplate.review-invariant-family.snapshot-core.v1",
      "artifact_core_domain": "pulseplate.review-invariant-family.artifact-core.v1",
      "artifact_core_excludes": [
        "artifact_fingerprint",
        "idempotency_key"
      ],
      "idempotency_uses_full_artifact_digest": true
    }
  },
  "$defs": {
    "falseAuthority": {
      "const": false
    },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_-]{0,62}[A-Za-z0-9])?$",
      "not": {
        "pattern": "(?:[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Kk][Ee][Yy]|[Aa][KkSs][Ii][Aa]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Bb][Ee][Aa][Rr][Ee][Rr]|[Cc][Ll][Ii][Ee][Nn][Tt][_-]?[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Gg][Hh][PpOoUuSsRr]_|[Gg][Ll][Pp][Aa][Tt]-|[Gg][Ii][Tt][Hh][Uu][Bb][_-]?[Pp][Aa][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Ss][Kk][_-]?(?:[Ll][Ii][Vv][Ee]|[Tt][Ee][Ss][Tt]|[Pp][Rr][Oo][Jj])|[Tt][Oo][Kk][Ee][Nn])"
      }
    },
    "findingIdList": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safeId"
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "finding_ids"
      ],
      "properties": {
        "family_id": {
          "$ref": "#/$defs/safeId"
        },
        "finding_ids": {
          "$ref": "#/$defs/findingIdList"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "universe_finding_ids",
        "families",
        "side_effects_allowed",
        "posting_allowed",
        "thread_resolution_allowed",
        "mapping_authority",
        "implementation_authority",
        "approval_authority",
        "review_authority",
        "security_authority",
        "runtime_authority",
        "learning_authority",
        "reflection_authority",
        "kpp_authority",
        "oracle_authority",
        "routing_authority",
        "promotion_authority",
        "merge_authority"
      ],
      "properties": {
        "schema_version": {
          "const": "review_invariant_family_snapshot.v1"
        },
        "universe_finding_ids": {
          "$ref": "#/$defs/findingIdList"
        },
        "families": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/family"
          }
        },
        "side_effects_allowed": {
          "$ref": "#/$defs/falseAuthority"
        },
        "posting_allowed": {
          "$ref": "#/$defs/falseAuthority"
        },
        "thread_resolution_allowed": {
          "$ref": "#/$defs/falseAuthority"
        },
        "mapping_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "implementation_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "approval_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "review_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "security_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "runtime_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "learning_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "reflection_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "kpp_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "oracle_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "routing_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "promotion_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "merge_authority": {
          "$ref": "#/$defs/falseAuthority"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_family_id",
        "right_family_id",
        "relation",
        "intersection_finding_ids",
        "left_only_finding_ids",
        "right_only_finding_ids"
      ],
      "properties": {
        "left_family_id": {
          "$ref": "#/$defs/safeId"
        },
        "right_family_id": {
          "$ref": "#/$defs/safeId"
        },
        "relation": {
          "enum": [
            "equal",
            "left_proper_subset",
            "right_proper_subset",
            "partial_overlap",
            "disjoint"
          ]
        },
        "intersection_finding_ids": {
          "$ref": "#/$defs/findingIdList"
        },
        "left_only_finding_ids": {
          "$ref": "#/$defs/findingIdList"
        },
        "right_only_finding_ids": {
          "$ref": "#/$defs/findingIdList"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_version",
        "snapshot",
        "snapshot_fingerprint",
        "relations",
        "unknown_finding_ids",
        "artifact_fingerprint",
        "idempotency_key",
        "side_effects_allowed",
        "posting_allowed",
        "thread_resolution_allowed",
        "mapping_authority",
        "implementation_authority",
        "approval_authority",
        "review_authority",
        "security_authority",
        "runtime_authority",
        "learning_authority",
        "reflection_authority",
        "kpp_authority",
        "oracle_authority",
        "routing_authority",
        "promotion_authority",
        "merge_authority"
      ],
      "properties": {
        "schema_version": {
          "const": "review_invariant_family_relations.v1"
        },
        "policy_version": {
          "const": "review_invariant_family_relations.policy.v1"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "snapshot_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "relations": {
          "type": "array",
          "maxItems": 496,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "unknown_finding_ids": {
          "$ref": "#/$defs/findingIdList"
        },
        "artifact_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^review-invariant-family-relations\\.v1:[a-f0-9]{64}$"
        },
        "side_effects_allowed": {
          "$ref": "#/$defs/falseAuthority"
        },
        "posting_allowed": {
          "$ref": "#/$defs/falseAuthority"
        },
        "thread_resolution_allowed": {
          "$ref": "#/$defs/falseAuthority"
        },
        "mapping_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "implementation_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "approval_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "review_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "security_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "runtime_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "learning_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "reflection_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "kpp_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "oracle_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "routing_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "promotion_authority": {
          "$ref": "#/$defs/falseAuthority"
        },
        "merge_authority": {
          "$ref": "#/$defs/falseAuthority"
        }
      }
    }
  }
}
