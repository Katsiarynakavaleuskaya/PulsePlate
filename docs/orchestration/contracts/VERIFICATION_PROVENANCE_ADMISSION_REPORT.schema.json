{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VERIFICATION_PROVENANCE_ADMISSION_REPORT.schema.json",
  "title": "Verification Provenance Admission Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_version",
    "generated_at",
    "scope",
    "generation_mode",
    "source_ids",
    "authority_flags",
    "provenance_contract",
    "path_categories"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_id": {
      "const": "verification_provenance_admission_report"
    },
    "report_version": {
      "const": "2026-06-05"
    },
    "generated_at": {
      "const": "static-2026-06-05"
    },
    "scope": {
      "const": "internal_only_verification_bundle_provenance_admission_report"
    },
    "generation_mode": {
      "const": "deterministic_static_ast_source_only"
    },
    "source_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_contract",
        "verification_registry",
        "rag_orchestration",
        "philosophical_runtime",
        "application_service",
        "semantic_cache_gate"
      ],
      "properties": {
        "verification_contract": {
          "const": "core/verification/contracts.py"
        },
        "verification_registry": {
          "const": "core/verification/registry.py"
        },
        "rag_orchestration": {
          "const": "core/rag/orchestration.py"
        },
        "philosophical_runtime": {
          "const": "core/insight/philosophical_runtime.py"
        },
        "application_service": {
          "const": "app/services/insight_application_service.py"
        },
        "semantic_cache_gate": {
          "const": "docs/roadmap/PulsePlate_Semantic_Cache_Gate_and_Plan.md"
        }
      }
    },
    "authority_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_api_changed",
        "openapi_changed",
        "db_persistence_changed",
        "provider_changed",
        "frontend_or_ios_changed",
        "runtime_authority_changed",
        "runtime_serving_behavior_changed",
        "admission_authority_changed",
        "semantic_cache_gate_status",
        "semantic_cache_allowed",
        "semantic_cache_runtime_allowed",
        "semantic_cache_implementation_allowed",
        "graphrag_allowed",
        "slack_or_operator_authority_allowed"
      ],
      "properties": {
        "public_api_changed": {
          "const": false
        },
        "openapi_changed": {
          "const": false
        },
        "db_persistence_changed": {
          "const": false
        },
        "provider_changed": {
          "const": false
        },
        "frontend_or_ios_changed": {
          "const": false
        },
        "runtime_authority_changed": {
          "const": false
        },
        "runtime_serving_behavior_changed": {
          "const": false
        },
        "admission_authority_changed": {
          "const": false
        },
        "semantic_cache_gate_status": {
          "const": "closed"
        },
        "semantic_cache_allowed": {
          "const": false
        },
        "semantic_cache_runtime_allowed": {
          "const": false
        },
        "semantic_cache_implementation_allowed": {
          "const": false
        },
        "graphrag_allowed": {
          "const": false
        },
        "slack_or_operator_authority_allowed": {
          "const": false
        }
      }
    },
    "provenance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_contract",
        "bundle_field",
        "metadata_scope",
        "redaction_source",
        "digest_label_format",
        "verification_status_values",
        "field_inventory",
        "raw_values_persisted",
        "public_response_surface"
      ],
      "properties": {
        "source_contract": {
          "const": "core/verification/contracts.py"
        },
        "bundle_field": {
          "const": "provenance"
        },
        "metadata_scope": {
          "const": "internal_only"
        },
        "redaction_source": {
          "const": "core.verification.registry.redacted_sha256_label"
        },
        "digest_label_format": {
          "const": "sha256:<64 lowercase hex>"
        },
        "verification_status_values": {
          "type": "array",
          "items": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "minItems": 3,
          "maxItems": 3
        },
        "field_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "kind",
              "safe_surface",
              "raw_value_allowed"
            ],
            "properties": {
              "field": {
                "enum": [
                  "input_digest",
                  "prompt_digest",
                  "context_item_digests",
                  "answer_digest",
                  "input_sha",
                  "prompt_sha",
                  "context_item_shas",
                  "answer_sha",
                  "prompt_char_count",
                  "prompt_trimmed",
                  "prompt_original_char_count",
                  "prompt_final_char_count",
                  "prompt_trim_limit",
                  "prompt_trimmed_char_count",
                  "verification_hops",
                  "verification_calls"
                ]
              },
              "kind": {
                "enum": [
                  "redacted_digest_label",
                  "redacted_digest_label_tuple",
                  "non_negative_count",
                  "boolean_or_null"
                ]
              },
              "safe_surface": {
                "const": "internal_metadata_only"
              },
              "raw_value_allowed": {
                "const": false
              }
            }
          },
          "minItems": 16,
          "maxItems": 16
        },
        "raw_values_persisted": {
          "const": false
        },
        "public_response_surface": {
          "const": false
        }
      }
    },
    "path_categories": {
      "type": "array",
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "rag_pre_generation"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "rag_runtime_merged"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "direct_local_non_verification_first_answer"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "runtime_verification_disabled_passthrough"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "fail_closed_missing_bundle_with_provenance"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "bundle_present",
          "overall_status",
          "admission_allowed",
          "reason_labels",
          "expected_provenance_fields",
          "present_provenance_fields",
          "missing_required_provenance_fields",
          "redacted_digest_labels",
          "count_labels",
          "redaction_assertions",
          "authority",
          "source_refs"
        ],
        "properties": {
          "id": {
            "enum": [
              "rag_pre_generation",
              "rag_runtime_merged",
              "direct_local_non_verification_first_answer",
              "runtime_verification_disabled_passthrough",
              "fail_closed_missing_bundle_with_provenance"
            ]
          },
          "bundle_present": {
            "const": true
          },
          "overall_status": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "admission_allowed": {
            "type": "boolean"
          },
          "reason_labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "expected_provenance_fields": {
            "$ref": "#/$defs/provenanceFields"
          },
          "present_provenance_fields": {
            "$ref": "#/$defs/provenanceFields"
          },
          "missing_required_provenance_fields": {
            "type": "array",
            "items": false,
            "maxItems": 0
          },
          "redacted_digest_labels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input_digest": {
                "$ref": "#/$defs/digestLabel"
              },
              "prompt_digest": {
                "$ref": "#/$defs/digestLabel"
              },
              "context_item_digests": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/digestLabel"
                },
                "minItems": 1
              },
              "answer_digest": {
                "$ref": "#/$defs/digestLabel"
              },
              "input_sha": {
                "$ref": "#/$defs/digestLabel"
              },
              "prompt_sha": {
                "$ref": "#/$defs/digestLabel"
              },
              "context_item_shas": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/digestLabel"
                },
                "minItems": 1
              },
              "answer_sha": {
                "$ref": "#/$defs/digestLabel"
              }
            }
          },
          "count_labels": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_count",
              "reason_code_count"
            ],
            "properties": {
              "artifact_count": {
                "type": "integer",
                "minimum": 0
              },
              "reason_code_count": {
                "type": "integer",
                "minimum": 0
              },
              "context_item_digest_count": {
                "type": "integer",
                "minimum": 0
              },
              "prompt_char_count": {
                "type": "integer",
                "minimum": 0
              },
              "prompt_original_char_count": {
                "type": "integer",
                "minimum": 0
              },
              "prompt_final_char_count": {
                "type": "integer",
                "minimum": 0
              },
              "prompt_trim_limit": {
                "type": "integer",
                "minimum": 0
              },
              "prompt_trimmed_char_count": {
                "type": "integer",
                "minimum": 0
              },
              "verification_hops": {
                "type": "integer",
                "minimum": 0
              },
              "verification_calls": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "redaction_assertions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "raw_prompt_absent",
              "raw_context_absent",
              "raw_answer_absent",
              "raw_user_text_absent",
              "local_paths_absent",
              "secrets_absent",
              "slack_ids_absent",
              "workflow_logs_absent",
              "provider_logs_absent",
              "operator_artifacts_absent",
              "health_data_absent"
            ],
            "properties": {
              "raw_prompt_absent": {
                "const": true
              },
              "raw_context_absent": {
                "const": true
              },
              "raw_answer_absent": {
                "const": true
              },
              "raw_user_text_absent": {
                "const": true
              },
              "local_paths_absent": {
                "const": true
              },
              "secrets_absent": {
                "const": true
              },
              "slack_ids_absent": {
                "const": true
              },
              "workflow_logs_absent": {
                "const": true
              },
              "provider_logs_absent": {
                "const": true
              },
              "operator_artifacts_absent": {
                "const": true
              },
              "health_data_absent": {
                "const": true
              }
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "public_api_changed",
              "runtime_authority_changed",
              "admission_authority_changed",
              "semantic_cache_gate_status",
              "cache_read_allowed",
              "cache_write_allowed",
              "serving_allowed"
            ],
            "properties": {
              "public_api_changed": {
                "const": false
              },
              "runtime_authority_changed": {
                "const": false
              },
              "admission_authority_changed": {
                "const": false
              },
              "semantic_cache_gate_status": {
                "const": "closed"
              },
              "cache_read_allowed": {
                "const": false
              },
              "cache_write_allowed": {
                "const": false
              },
              "serving_allowed": {
                "const": false
              }
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "symbol"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "symbol": {
                  "type": "string"
                }
              }
            },
            "minItems": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "const": "rag_pre_generation"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "properties": {
                "admission_allowed": {
                  "const": true
                },
                "redacted_digest_labels": {
                  "required": [
                    "input_digest",
                    "prompt_digest",
                    "context_item_digests",
                    "input_sha",
                    "prompt_sha",
                    "context_item_shas"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "rag_runtime_merged"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "properties": {
                "admission_allowed": {
                  "const": true
                },
                "redacted_digest_labels": {
                  "required": [
                    "input_digest",
                    "prompt_digest",
                    "context_item_digests",
                    "answer_digest",
                    "input_sha",
                    "prompt_sha",
                    "context_item_shas",
                    "answer_sha"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "direct_local_non_verification_first_answer"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "properties": {
                "admission_allowed": {
                  "const": false
                },
                "redacted_digest_labels": {
                  "required": [
                    "input_digest",
                    "answer_digest",
                    "input_sha",
                    "answer_sha"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "runtime_verification_disabled_passthrough"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "properties": {
                "admission_allowed": {
                  "const": false
                },
                "redacted_digest_labels": {
                  "required": [
                    "input_digest",
                    "prompt_digest",
                    "context_item_digests",
                    "answer_digest",
                    "input_sha",
                    "prompt_sha",
                    "context_item_shas",
                    "answer_sha"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "fail_closed_missing_bundle_with_provenance"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "properties": {
                "admission_allowed": {
                  "const": false
                },
                "redacted_digest_labels": {
                  "required": [
                    "input_digest",
                    "answer_digest",
                    "input_sha",
                    "answer_sha"
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 5,
      "maxItems": 5
    }
  },
  "$defs": {
    "digestLabel": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenanceFields": {
      "type": "array",
      "items": {
        "enum": [
          "input_digest",
          "prompt_digest",
          "context_item_digests",
          "answer_digest",
          "input_sha",
          "prompt_sha",
          "context_item_shas",
          "answer_sha",
          "prompt_char_count",
          "prompt_trimmed",
          "prompt_original_char_count",
          "prompt_final_char_count",
          "prompt_trim_limit",
          "prompt_trimmed_char_count",
          "verification_hops",
          "verification_calls"
        ]
      },
      "minItems": 1
    }
  }
}
