{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/creative_code_pr_promotion_plan.v1.schema.json",
  "title": "CreativeCodePRPromotionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "policy_version",
    "promotion_id",
    "idempotency_key",
    "source_result_id",
    "source_request_id",
    "source_bundle_id",
    "source_bundle_fingerprint",
    "selected_variant_id",
    "selected_variant_fingerprint",
    "patch_fingerprint",
    "base_commit_sha",
    "changed_paths",
    "target_repository",
    "target_base_branch",
    "target_head_branch",
    "pull_request_mode",
    "pull_request_title",
    "pull_request_body_fingerprint",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "creative_code_pr_promotion_plan" },
    "policy_version": { "const": "creative-code-pr-promotion-pr3" },
    "promotion_id": { "$ref": "#/$defs/promotion_id" },
    "idempotency_key": { "$ref": "#/$defs/safe_id" },
    "source_result_id": { "$ref": "#/$defs/safe_id" },
    "source_request_id": { "$ref": "#/$defs/safe_id" },
    "source_bundle_id": { "$ref": "#/$defs/safe_id" },
    "source_bundle_fingerprint": { "$ref": "#/$defs/sha256" },
    "selected_variant_id": { "$ref": "#/$defs/safe_id" },
    "selected_variant_fingerprint": { "$ref": "#/$defs/sha256" },
    "patch_fingerprint": { "$ref": "#/$defs/sha256" },
    "base_commit_sha": { "$ref": "#/$defs/git_sha" },
    "changed_paths": { "$ref": "#/$defs/path_array" },
    "target_repository": { "const": "Katsiarynakavaleuskaya/PulsePlate" },
    "target_base_branch": { "const": "main" },
    "target_head_branch": { "$ref": "#/$defs/experiment_branch" },
    "pull_request_mode": { "const": "non_draft" },
    "pull_request_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()#,+-]{0,119}$"
    },
    "pull_request_body_fingerprint": { "$ref": "#/$defs/sha256" },
    "authority": { "$ref": "#/$defs/authority" }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "promotion_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "experiment_branch": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^experiment/[a-z0-9][a-z0-9._-]{0,68}$"
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/|~|[A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!\\.git(?:/|$))(?!\\.github(?:/|$))(?!\\.gitmodules$)(?!\\.mypy_cache(?:/|$))(?!\\.pytest_cache(?:/|$))(?!\\.ruff_cache(?:/|$))(?!\\.venv(?:/|$))(?!AGENTS\\.md$)(?!RUNBOOK_AGENT\\.md$)(?!artifacts(?:/|$))(?!build(?:/|$))(?!dist(?:/|$))(?!docs/review(?:/|$))(?!frontend(?:/|$))(?!ios(?:/|$))(?!node_modules(?:/|$))(?!scripts/ci(?:/|$))(?!worktrees(?:/|$)).+"
    },
    "path_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repo_path" }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_merge_readiness",
        "create_new_branch",
        "force_push",
        "merge",
        "modify_existing_branch",
        "modify_github_app_settings",
        "modify_slack_settings",
        "open_draft_pull_request",
        "open_non_draft_pull_request",
        "push_new_branch",
        "release",
        "request_review",
        "resolve_review_threads",
        "submit_review",
        "write_default_branch"
      ],
      "properties": {
        "create_new_branch": { "const": true },
        "push_new_branch": { "const": true },
        "open_non_draft_pull_request": { "const": true },
        "open_draft_pull_request": { "const": false },
        "modify_existing_branch": { "const": false },
        "force_push": { "const": false },
        "write_default_branch": { "const": false },
        "request_review": { "const": false },
        "submit_review": { "const": false },
        "resolve_review_threads": { "const": false },
        "claim_merge_readiness": { "const": false },
        "merge": { "const": false },
        "release": { "const": false },
        "modify_github_app_settings": { "const": false },
        "modify_slack_settings": { "const": false }
      }
    }
  }
}
