{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/creative_hypothesis_agent_routing.v1.schema.json",
  "title": "CreativeHypothesisAgentRouting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "policy_version",
    "routing_id",
    "idempotency_key",
    "source_hypothesis_packet_id",
    "source_hypothesis_packet_fingerprint",
    "routing",
    "agent_review_mode",
    "authority",
    "sanitized"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "creative_hypothesis_agent_routing" },
    "policy_version": { "const": "experiment-runner-pr-creative-context-v1" },
    "routing_id": { "$ref": "#/$defs/safe_id" },
    "idempotency_key": { "$ref": "#/$defs/safe_id" },
    "source_hypothesis_packet_id": { "$ref": "#/$defs/safe_id" },
    "source_hypothesis_packet_fingerprint": { "$ref": "#/$defs/sha256" },
    "routing": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    },
    "agent_review_mode": { "const": "critique_refine_only" },
    "authority": { "$ref": "#/$defs/authority" },
    "sanitized": { "const": true }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "agent_slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "primary_agent",
        "review_agents",
        "cross_domain_agents",
        "missing_agent_capabilities",
        "coordinator_decision_required",
        "mutation_authority"
      ],
      "properties": {
        "hypothesis_id": { "$ref": "#/$defs/safe_id" },
        "primary_agent": { "$ref": "#/$defs/agent_slug" },
        "review_agents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agent_slug" }
        },
        "cross_domain_agents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agent_slug" }
        },
        "missing_agent_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agent_slug" }
        },
        "coordinator_decision_required": { "const": true },
        "mutation_authority": { "const": false }
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "generate_hypotheses": { "const": true },
        "route_to_agents": { "const": true },
        "generate_patch": { "const": false },
        "write_branch": { "const": false },
        "push": { "const": false },
        "merge": { "const": false },
        "call_provider": { "const": false },
        "modify_workflows": { "const": false }
      },
      "additionalProperties": { "type": "boolean" }
    }
  }
}
