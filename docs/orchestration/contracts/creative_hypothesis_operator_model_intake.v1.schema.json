{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/creative_hypothesis_operator_model_intake.v1.schema.json",
  "title": "CreativeHypothesisOperatorModelIntake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "policy_version",
    "context_map_id",
    "context_map_fingerprint",
    "generation",
    "hypotheses",
    "authority",
    "sanitized"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "creative_hypothesis_operator_model_intake" },
    "policy_version": { "const": "creative-hypothesis-operator-intake-v1" },
    "intake_id": { "$ref": "#/$defs/safe_id" },
    "idempotency_key": { "$ref": "#/$defs/safe_id" },
    "context_map_id": { "$ref": "#/$defs/safe_id" },
    "context_map_fingerprint": { "$ref": "#/$defs/sha256" },
    "generation": { "$ref": "#/$defs/generation" },
    "hypothesis_count": { "type": "integer", "minimum": 3, "maximum": 5 },
    "hypotheses": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/operator_hypothesis" }
    },
    "authority": { "$ref": "#/$defs/intake_authority" },
    "sanitized": { "const": true }
  },
  "allOf": [
    {
      "if": {
        "required": ["hypothesis_count"],
        "properties": { "hypothesis_count": { "const": 3 } }
      },
      "then": { "properties": { "hypotheses": { "minItems": 3, "maxItems": 3 } } }
    },
    {
      "if": {
        "required": ["hypothesis_count"],
        "properties": { "hypothesis_count": { "const": 4 } }
      },
      "then": { "properties": { "hypotheses": { "minItems": 4, "maxItems": 4 } } }
    },
    {
      "if": {
        "required": ["hypothesis_count"],
        "properties": { "hypothesis_count": { "const": 5 } }
      },
      "then": { "properties": { "hypotheses": { "minItems": 5, "maxItems": 5 } } }
    }
  ],
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repo_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-][A-Za-z0-9_./-]*$",
      "not": {
        "pattern": "(^/|^\\.$|^\\*$|^\\*\\*$|\\.\\.|\\\\|file://|^~|^\\.git/|^\\.venv/|^worktrees/|^artifacts(/|$)|^(app|core|frontend|ios|providers|alembic)(/|$)|^\\.github/workflows(/|$))"
      }
    },
    "concrete_target_path": {
      "allOf": [
        { "$ref": "#/$defs/repo_path" },
        {
          "pattern": "^(scripts/|tests/|docs/orchestration/contracts/|docs/prompts/|tools/codex_skills/|\\.agents/skills/)"
        }
      ]
    },
    "repo_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repo_path" }
    },
    "safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 360,
      "not": {
        "anyOf": [
          { "pattern": "[dD][iI][fF][fF] --[gG][iI][tT]" },
          { "pattern": "@@" },
          { "pattern": "\\+\\+\\+\\s+[ab]/" },
          { "pattern": "---\\s+[ab]/" },
          { "pattern": "[cC][aA][nN][dD][iI][dD][aA][tT][eE]\\.[pP][aA][tT][cC][hH]" },
          { "pattern": "[cC][aA][nN][dD][iI][dD][aA][tT][eE][_ -]?[pP][aA][tT][cC][hH]" },
          { "pattern": "[rR][aA][wW][_ -]?([mM][oO][dD][eE][lL][_ -]?[pP][aA][yY][lL][oO][aA][dD]|[bB][oO][dD][yY]|[pP][rR][oO][mM][pP][tT]|[rR][eE][sS][pP][oO][nN][sS][eE]|[cC][oO][nN][tT][eE][xX][tT]|[pP][aA][tT][cC][hH]|[rR][eE][vV][iI][eE][wW]|[pP][rR])" },
          { "pattern": "[cC][hH][aA][iI][nN][_ -]?[oO][fF][_ -]?[tT][hH][oO][uU][gG][hH][tT]" },
          { "pattern": "[pP][rR][oO][vV][iI][dD][eE][rR][_ -]?[pP][aA][yY][lL][oO][aA][dD]" },
          { "pattern": "[oO][rR][aA][cC][lL][eE][_ -]?([sS][tT][dD][oO][uU][tT]|[sS][tT][dD][eE][rR][rR]|[oO][uU][tT][pP][uU][tT])" },
          { "pattern": "[fF][iI][lL][eE]://" },
          { "pattern": "/([Uu][Ss][Ee][Rr][Ss]|[Hh][Oo][Mm][Ee]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]/[Vv][Aa][Rr]|[Vv][Aa][Rr]/[Ff][Oo][Ll][Dd][Ee][Rr][Ss]|[Tt][Mm][Pp]|[Ee][Tt][Cc]|[Oo][Pp][Tt]|[Uu][Ss][Rr]|[Vv][Oo][Ll][Uu][Mm][Ee][Ss]|[Mm][Nn][Tt]|[Rr][Oo][Oo][Tt]|[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee]|[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee][Ss])(/|$)" },
          { "pattern": "~[/\\\\]|[A-Za-z]:[\\\\/]|\\.[vV][eE][nN][vV]/|\\.[gG][iI][tT]/" },
          { "pattern": "[wW][oO][rR][kK][tT][rR][eE][eE][sS]([:/._-]|$)" },
          { "pattern": "[mM][eE][rR][gG][eE][-_ ]?[rR][eE][aA][dD][yY]|[rR][eE][aA][dD][yY] to [mM][eE][rR][gG][eE]|[mM][eE][rR][gG][eE][aA][bB][lL][eE]" },
          { "pattern": "[sS][kK]-[A-Za-z0-9_-]{12,}|[gG][hH][pPsSoOrRuU]_[A-Za-z0-9_.-]{12,}|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_|[xX][oO][xX][abprsABPRS]-" },
          { "pattern": "[aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]:\\s*[bB][eE][aA][rR][eE][rR]|[pP][rR][iI][vV][aA][tT][eE][_ -]?[kK][eE][yY]|[aA][pP][iI][_ -]?[kK][eE][yY]|[gG][hH]_[tT][oO][kK][eE][nN]|[gG][iI][tT][hH][uU][bB]_[tT][oO][kK][eE][nN]" }
        ]
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "tool_label",
        "repo_provider_calls",
        "raw_model_payload_stored",
        "semantic_cache_used"
      ],
      "properties": {
        "mode": { "const": "operator_supplied_model_json" },
        "tool_label": {
          "enum": ["codex", "comet", "ollama", "other_local", "unknown"]
        },
        "repo_provider_calls": { "const": false },
        "raw_model_payload_stored": { "const": false },
        "semantic_cache_used": { "const": false }
      }
    },
    "analogy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_domain",
        "analogy",
        "target_repo_surface",
        "why_useful",
        "risk",
        "requires_specialist_agent"
      ],
      "properties": {
        "source_domain": {
          "enum": [
            "philosophy",
            "nutrition",
            "security",
            "data",
            "UX",
            "testing",
            "economics",
            "biology",
            "CBT",
            "information_theory"
          ]
        },
        "analogy": { "$ref": "#/$defs/safe_text" },
        "target_repo_surface": { "$ref": "#/$defs/repo_path" },
        "why_useful": { "$ref": "#/$defs/safe_text" },
        "risk": { "$ref": "#/$defs/safe_text" },
        "requires_specialist_agent": { "type": "boolean" }
      }
    },
    "operator_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_kind",
        "title",
        "target_surfaces",
        "expected_behavior",
        "tests_or_oracles",
        "risk_notes",
        "cross_domain_analogies",
        "falsifier",
        "negative_controls",
        "requires_human_approval",
        "eligible_for_pr1_specification",
        "eligible_for_pr2_patch"
      ],
      "properties": {
        "hypothesis_kind": {
          "enum": [
            "architecture",
            "security_authority",
            "testing_oracle",
            "creative_protocol",
            "scientific_stats"
          ]
        },
        "title": { "$ref": "#/$defs/safe_text" },
        "target_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/concrete_target_path" }
        },
        "expected_behavior": { "$ref": "#/$defs/safe_text" },
        "tests_or_oracles": { "$ref": "#/$defs/repo_paths" },
        "risk_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/safe_text" }
        },
        "cross_domain_analogies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/analogy" }
        },
        "falsifier": { "$ref": "#/$defs/safe_text" },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/safe_text" }
        },
        "requires_human_approval": { "const": true },
        "eligible_for_pr1_specification": { "const": true },
        "eligible_for_pr2_patch": { "const": false }
      }
    },
    "intake_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_product_runtime",
        "call_provider",
        "change_client_runtime",
        "change_openapi",
        "claim_merge_readiness",
        "create_branch",
        "edit_fixed_mapping",
        "execute_pr1_specification",
        "execute_pr2_patch_builder",
        "execute_pr3_promotion",
        "generate_patch",
        "mark_pr_ready",
        "merge",
        "modify_github_app",
        "modify_slack",
        "modify_workflows",
        "open_draft_pr",
        "open_pr",
        "operator_supplied_hypotheses",
        "post_github_comment",
        "push",
        "read_secrets",
        "release",
        "repo_provider_calls",
        "resolve_threads",
        "use_semantic_cache",
        "workflow_dispatch",
        "write_branch"
      ],
      "properties": {
        "call_product_runtime": { "const": false },
        "call_provider": { "const": false },
        "change_client_runtime": { "const": false },
        "change_openapi": { "const": false },
        "claim_merge_readiness": { "const": false },
        "create_branch": { "const": false },
        "edit_fixed_mapping": { "const": false },
        "execute_pr1_specification": { "const": false },
        "execute_pr2_patch_builder": { "const": false },
        "execute_pr3_promotion": { "const": false },
        "generate_patch": { "const": false },
        "mark_pr_ready": { "const": false },
        "merge": { "const": false },
        "modify_github_app": { "const": false },
        "modify_slack": { "const": false },
        "modify_workflows": { "const": false },
        "open_draft_pr": { "const": false },
        "open_pr": { "const": false },
        "operator_supplied_hypotheses": { "const": true },
        "post_github_comment": { "const": false },
        "push": { "const": false },
        "read_secrets": { "const": false },
        "release": { "const": false },
        "repo_provider_calls": { "const": false },
        "resolve_threads": { "const": false },
        "use_semantic_cache": { "const": false },
        "workflow_dispatch": { "const": false },
        "write_branch": { "const": false }
      }
    }
  }
}
