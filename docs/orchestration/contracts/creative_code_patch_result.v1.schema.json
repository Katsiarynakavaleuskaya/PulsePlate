{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/creative_code_patch_result.v1.schema.json",
  "title": "CreativeCodePatchResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_type",
    "result_id",
    "idempotency_key",
    "policy_version",
    "request_id",
    "source_bundle_id",
    "source_bundle_fingerprint",
    "selected_variant_id",
    "selected_variant_fingerprint",
    "base_commit_sha",
    "status",
    "failure_class",
    "changed_paths",
    "patch_summary",
    "workspace_summary",
    "runner_summary",
    "authority",
    "promotion_ready",
    "sanitized"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "result_type": { "const": "creative_code_patch_result" },
    "result_id": { "$ref": "#/$defs/safe_id" },
    "idempotency_key": { "$ref": "#/$defs/safe_id" },
    "policy_version": { "const": "creative-code-patch-builder-pr2" },
    "request_id": { "$ref": "#/$defs/safe_id" },
    "source_bundle_id": { "$ref": "#/$defs/safe_id" },
    "source_bundle_fingerprint": { "$ref": "#/$defs/sha256" },
    "selected_variant_id": { "$ref": "#/$defs/safe_id" },
    "selected_variant_fingerprint": { "$ref": "#/$defs/sha256" },
    "base_commit_sha": { "$ref": "#/$defs/git_sha" },
    "status": { "enum": ["accepted", "rejected"] },
    "failure_class": { "$ref": "#/$defs/failure_class" },
    "changed_paths": { "$ref": "#/$defs/path_array" },
    "patch_summary": { "$ref": "#/$defs/patch_summary" },
    "workspace_summary": { "$ref": "#/$defs/workspace_summary" },
    "runner_summary": { "$ref": "#/$defs/runner_summary" },
    "authority": { "$ref": "#/$defs/authority" },
    "promotion_ready": { "const": false },
    "sanitized": { "const": true }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "accepted" } }
      },
      "then": {
        "properties": {
          "failure_class": { "const": null },
          "workspace_summary": {
            "properties": {
              "origin_removed": { "const": true },
              "checkout_destroyed": { "const": true },
              "shared_tree_untouched": { "const": true }
            }
          },
          "runner_summary": { "$ref": "#/$defs/accepted_runner_proof" }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "rejected" } }
      },
      "then": {
        "properties": {
          "failure_class": {
            "enum": [
              "timeout",
              "oom",
              "metric_regression",
              "guard_failure",
              "policy_violation",
              "unchanged_result",
              "capability_mismatch",
              "infra_flake"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["failure_class"],
        "properties": { "failure_class": { "const": "capability_mismatch" } }
      },
      "then": {
        "properties": {
          "runner_summary": {
            "required": ["status", "failure_class"],
            "properties": {
              "status": { "const": "rejected" },
              "failure_class": { "const": "capability_mismatch" },
              "attempts": { "enum": [0, 1] },
              "retries_consumed": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["failure_class"],
        "properties": { "failure_class": { "const": "policy_violation" } }
      },
      "then": {
        "properties": {
          "runner_summary": {
            "required": ["status", "failure_class"],
            "properties": {
              "status": { "const": "rejected" },
              "failure_class": { "const": "policy_violation" },
              "attempts": { "enum": [0, 1] },
              "retries_consumed": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["status", "runner_summary"],
        "properties": {
          "status": { "const": "rejected" },
          "runner_summary": {
            "required": ["status"],
            "properties": { "status": { "const": "rejected" } }
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "failure_class": { "const": "timeout" },
              "runner_summary": {
                "properties": { "failure_class": { "const": "timeout" } }
              }
            }
          },
          {
            "properties": {
              "failure_class": { "const": "oom" },
              "runner_summary": {
                "properties": { "failure_class": { "const": "oom" } }
              }
            }
          },
          {
            "properties": {
              "failure_class": { "const": "metric_regression" },
              "runner_summary": {
                "properties": { "failure_class": { "const": "metric_regression" } }
              }
            }
          },
          {
            "properties": {
              "failure_class": { "const": "guard_failure" },
              "runner_summary": {
                "properties": { "failure_class": { "const": "guard_failure" } }
              }
            }
          },
          {
            "properties": {
              "failure_class": { "const": "policy_violation" },
              "runner_summary": {
                "properties": { "failure_class": { "const": "policy_violation" } }
              }
            }
          },
          {
            "properties": {
              "failure_class": { "const": "unchanged_result" },
              "runner_summary": {
                "properties": { "failure_class": { "const": "unchanged_result" } }
              }
            }
          },
          {
            "properties": {
              "failure_class": { "const": "capability_mismatch" },
              "runner_summary": {
                "properties": { "failure_class": { "const": "capability_mismatch" } }
              }
            }
          },
          {
            "properties": {
              "failure_class": { "const": "infra_flake" },
              "runner_summary": {
                "properties": { "failure_class": { "const": "infra_flake" } }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "failure_class": {
      "enum": [
        null,
        "timeout",
        "oom",
        "metric_regression",
        "guard_failure",
        "policy_violation",
        "unchanged_result",
        "capability_mismatch",
        "infra_flake"
      ]
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/|~|[A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!\\.git(?:/|$))(?!\\.github(?:/|$))(?!\\.gitmodules$)(?!\\.mypy_cache(?:/|$))(?!\\.pytest_cache(?:/|$))(?!\\.ruff_cache(?:/|$))(?!\\.venv(?:/|$))(?!AGENTS\\.md$)(?!RUNBOOK_AGENT\\.md$)(?!artifacts(?:/|$))(?!build(?:/|$))(?!dist(?:/|$))(?!docs/orchestration(?:/|$))(?!docs/review(?:/|$))(?!frontend(?:/|$))(?!ios(?:/|$))(?!node_modules(?:/|$))(?!scripts/ci(?:/|$))(?!tests(?:/|$))(?!worktrees(?:/|$)).+"
    },
    "path_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repo_path" }
    },
    "patch_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch_fingerprint", "patch_bytes", "diff_lines"],
      "properties": {
        "patch_fingerprint": { "$ref": "#/$defs/sha256" },
        "patch_bytes": { "type": "integer", "minimum": 1, "maximum": 524288 },
        "diff_lines": { "type": "integer", "minimum": 1, "maximum": 800 }
      }
    },
    "workspace_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detached_base_sha",
        "origin_removed",
        "checkout_destroyed",
        "shared_tree_untouched"
      ],
      "properties": {
        "detached_base_sha": { "$ref": "#/$defs/git_sha" },
        "origin_removed": { "type": "boolean" },
        "checkout_destroyed": { "type": "boolean" },
        "shared_tree_untouched": { "type": "boolean" }
      }
    },
    "runner_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "status",
        "failure_class",
        "mutated_path_count",
        "oracle_commands_configured",
        "oracle_commands_executed",
        "attempts",
        "retries_consumed",
        "shared_tree_untouched",
        "runner_result_fingerprint",
        "runner_error_present",
        "runner_error_fingerprint"
      ],
      "properties": {
        "experiment_id": { "$ref": "#/$defs/safe_id" },
        "status": { "enum": ["accepted", "rejected"] },
        "failure_class": { "$ref": "#/$defs/failure_class" },
        "mutated_path_count": { "type": "integer", "minimum": 0, "maximum": 5 },
        "oracle_commands_configured": { "type": "integer", "minimum": 0, "maximum": 20 },
        "oracle_commands_executed": { "type": "integer", "minimum": 0, "maximum": 20 },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
        "retries_consumed": { "type": "integer", "minimum": 0, "maximum": 2 },
        "shared_tree_untouched": { "type": "boolean" },
        "runner_result_fingerprint": { "$ref": "#/$defs/sha256" },
        "runner_error_present": { "type": "boolean" },
        "runner_error_fingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "accepted" } }
          },
          "then": { "properties": { "failure_class": { "const": null } } }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "rejected" } }
          },
          "then": {
            "properties": {
              "failure_class": {
                "enum": [
                  "timeout",
                  "oom",
                  "metric_regression",
                  "guard_failure",
                  "policy_violation",
                  "unchanged_result",
                  "capability_mismatch",
                  "infra_flake"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["failure_class"],
            "properties": { "failure_class": { "const": "capability_mismatch" } }
          },
          "then": {
            "properties": {
              "attempts": { "enum": [0, 1] },
              "retries_consumed": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["failure_class"],
            "properties": { "failure_class": { "const": "policy_violation" } }
          },
          "then": {
            "properties": {
              "attempts": { "enum": [0, 1] },
              "retries_consumed": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["failure_class", "attempts"],
            "properties": {
              "failure_class": { "const": "capability_mismatch" },
              "attempts": { "const": 0 }
            }
          },
          "then": {
            "properties": {
              "mutated_path_count": { "const": 0 },
              "oracle_commands_executed": { "const": 0 }
            }
          }
        }
      ]
    },
    "accepted_runner_proof": {
      "type": "object",
      "required": [
        "status",
        "failure_class",
        "oracle_commands_configured",
        "oracle_commands_executed",
        "shared_tree_untouched"
      ],
      "properties": {
        "status": { "const": "accepted" },
        "failure_class": { "const": null },
        "oracle_commands_configured": { "type": "integer", "minimum": 1, "maximum": 20 },
        "oracle_commands_executed": { "type": "integer", "minimum": 1, "maximum": 20 },
        "shared_tree_untouched": { "const": true }
      },
      "oneOf": [
        { "properties": { "oracle_commands_configured": { "const": 1 }, "oracle_commands_executed": { "const": 1 } } },
        { "properties": { "oracle_commands_configured": { "const": 2 }, "oracle_commands_executed": { "const": 2 } } },
        { "properties": { "oracle_commands_configured": { "const": 3 }, "oracle_commands_executed": { "const": 3 } } },
        { "properties": { "oracle_commands_configured": { "const": 4 }, "oracle_commands_executed": { "const": 4 } } },
        { "properties": { "oracle_commands_configured": { "const": 5 }, "oracle_commands_executed": { "const": 5 } } },
        { "properties": { "oracle_commands_configured": { "const": 6 }, "oracle_commands_executed": { "const": 6 } } },
        { "properties": { "oracle_commands_configured": { "const": 7 }, "oracle_commands_executed": { "const": 7 } } },
        { "properties": { "oracle_commands_configured": { "const": 8 }, "oracle_commands_executed": { "const": 8 } } },
        { "properties": { "oracle_commands_configured": { "const": 9 }, "oracle_commands_executed": { "const": 9 } } },
        { "properties": { "oracle_commands_configured": { "const": 10 }, "oracle_commands_executed": { "const": 10 } } },
        { "properties": { "oracle_commands_configured": { "const": 11 }, "oracle_commands_executed": { "const": 11 } } },
        { "properties": { "oracle_commands_configured": { "const": 12 }, "oracle_commands_executed": { "const": 12 } } },
        { "properties": { "oracle_commands_configured": { "const": 13 }, "oracle_commands_executed": { "const": 13 } } },
        { "properties": { "oracle_commands_configured": { "const": 14 }, "oracle_commands_executed": { "const": 14 } } },
        { "properties": { "oracle_commands_configured": { "const": 15 }, "oracle_commands_executed": { "const": 15 } } },
        { "properties": { "oracle_commands_configured": { "const": 16 }, "oracle_commands_executed": { "const": 16 } } },
        { "properties": { "oracle_commands_configured": { "const": 17 }, "oracle_commands_executed": { "const": 17 } } },
        { "properties": { "oracle_commands_configured": { "const": 18 }, "oracle_commands_executed": { "const": 18 } } },
        { "properties": { "oracle_commands_configured": { "const": 19 }, "oracle_commands_executed": { "const": 19 } } },
        { "properties": { "oracle_commands_configured": { "const": 20 }, "oracle_commands_executed": { "const": 20 } } }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_patch_generated",
        "candidate_patch_evaluated",
        "write_repository",
        "open_pull_request",
        "resolve_review_threads",
        "merge",
        "promotion"
      ],
      "properties": {
        "candidate_patch_generated": { "const": true },
        "candidate_patch_evaluated": { "const": true },
        "write_repository": { "const": false },
        "open_pull_request": { "const": false },
        "resolve_review_threads": { "const": false },
        "merge": { "const": false },
        "promotion": { "const": false }
      }
    }
  }
}
