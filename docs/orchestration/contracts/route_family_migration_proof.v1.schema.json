{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/route_family_migration_proof.v1.schema.json",
  "title": "PulsePlate Route Family Migration Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_family",
    "runtime_mutation_allowed",
    "owner_proof",
    "auth_proof",
    "openapi_proof",
    "duplicate_route_proof",
    "partial_registration_proof",
    "legacy_growth_proof",
    "rollback_proof"
  ],
  "properties": {
    "schema_version": { "const": "route_family_migration_proof.v1" },
    "route_family": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
    },
    "runtime_mutation_allowed": { "const": false },
    "owner_proof": { "$ref": "#/$defs/proof_section" },
    "auth_proof": { "$ref": "#/$defs/proof_section" },
    "openapi_proof": { "$ref": "#/$defs/proof_section" },
    "duplicate_route_proof": { "$ref": "#/$defs/proof_section" },
    "partial_registration_proof": { "$ref": "#/$defs/proof_section" },
    "legacy_growth_proof": { "$ref": "#/$defs/proof_section" },
    "rollback_proof": { "$ref": "#/$defs/proof_section" }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-][A-Za-z0-9_./:-]*$",
      "not": {
        "pattern": "(^/|\\.\\.|\\\\|file://|^~|^[A-Za-z][A-Za-z0-9+.-]*://|^[A-Za-z]:|^\\.git/|^\\.venv/|^worktrees/|^artifacts(/|$)|^(Users|home|private|tmp|var|Volumes|mnt|root|workspace|workspaces)(/|$))"
      }
    },
    "proof_section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "summary", "evidence_refs"],
      "properties": {
        "checked": { "const": true },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360,
          "pattern": "\\S"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repo_path" }
        }
      }
    }
  }
}
