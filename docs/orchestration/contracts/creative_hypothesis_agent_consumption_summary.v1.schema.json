{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/creative_hypothesis_agent_consumption_summary.v1.schema.json",
  "title": "CreativeHypothesisAgentConsumptionSummary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "policy_version",
    "summary_id",
    "idempotency_key",
    "source_hypothesis_packet_id",
    "source_agent_routing_id",
    "oracle_status",
    "hypothesis_count",
    "creative_status",
    "recommended_agents",
    "next_allowed_action",
    "requires_human_approval",
    "coauthor_required",
    "authority",
    "sanitized"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "creative_hypothesis_agent_consumption_summary" },
    "policy_version": { "const": "experiment-runner-pr-creative-context-v1" },
    "summary_id": { "$ref": "#/$defs/safe_id" },
    "idempotency_key": { "$ref": "#/$defs/safe_id" },
    "source_hypothesis_packet_id": { "$ref": "#/$defs/safe_id" },
    "source_agent_routing_id": { "$ref": "#/$defs/safe_id" },
    "oracle_status": { "enum": ["accepted", "rejected", "skipped", "failed"] },
    "hypothesis_count": { "type": "integer", "minimum": 0, "maximum": 5 },
    "creative_status": {
      "enum": ["hypotheses_generated", "no_creative_action", "blocked"]
    },
    "recommended_agents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/agent_slug" }
    },
    "next_allowed_action": {
      "enum": ["agent_review", "approve_pr1_specification", "no_action", "hold"]
    },
    "requires_human_approval": { "type": "boolean" },
    "coauthor_required": { "type": "boolean" },
    "authority": { "$ref": "#/$defs/authority" },
    "sanitized": { "const": true }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "agent_slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_product_runtime",
        "call_provider",
        "change_client_runtime",
        "change_openapi",
        "claim_merge_readiness",
        "create_branch",
        "edit_fixed_mapping",
        "emit_local_artifacts",
        "execute_pr1_specification",
        "execute_pr2_patch_builder",
        "execute_pr3_promotion",
        "generate_hypotheses",
        "generate_patch",
        "mark_pr_ready",
        "merge",
        "modify_github_app",
        "modify_slack",
        "modify_workflows",
        "open_draft_pr",
        "open_pr",
        "post_github_comment",
        "prepare_human_approval_packet",
        "push",
        "read_sanitized_context",
        "read_secrets",
        "release",
        "resolve_threads",
        "route_to_agents",
        "use_semantic_cache",
        "workflow_dispatch",
        "write_branch"
      ],
      "properties": {
        "call_product_runtime": { "const": false },
        "call_provider": { "const": false },
        "change_client_runtime": { "const": false },
        "change_openapi": { "const": false },
        "claim_merge_readiness": { "const": false },
        "create_branch": { "const": false },
        "edit_fixed_mapping": { "const": false },
        "emit_local_artifacts": { "const": true },
        "execute_pr1_specification": { "const": false },
        "execute_pr2_patch_builder": { "const": false },
        "execute_pr3_promotion": { "const": false },
        "generate_hypotheses": { "const": true },
        "generate_patch": { "const": false },
        "mark_pr_ready": { "const": false },
        "merge": { "const": false },
        "modify_github_app": { "const": false },
        "modify_slack": { "const": false },
        "modify_workflows": { "const": false },
        "open_draft_pr": { "const": false },
        "open_pr": { "const": false },
        "post_github_comment": { "const": false },
        "prepare_human_approval_packet": { "const": true },
        "push": { "const": false },
        "read_sanitized_context": { "const": true },
        "read_secrets": { "const": false },
        "release": { "const": false },
        "resolve_threads": { "const": false },
        "route_to_agents": { "const": true },
        "use_semantic_cache": { "const": false },
        "workflow_dispatch": { "const": false },
        "write_branch": { "const": false }
      }
    }
  }
}
