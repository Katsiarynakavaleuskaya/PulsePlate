{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Cache Embedding Retrieval Admission Telemetry Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_status",
    "runtime_allowed",
    "implementation_allowed",
    "admission_allowed",
    "embedding_allowed",
    "retrieval_runtime_allowed",
    "semantic_similarity_allowed",
    "vector_search_allowed",
    "provider_calls_allowed",
    "provider_wiring_allowed",
    "cache_read_allowed",
    "cache_write_allowed",
    "serving_allowed",
    "model_downgrade_allowed",
    "pricing_truth_allowed",
    "telemetry_phase",
    "authority_boundary",
    "asset_type",
    "selected_embedding_backend",
    "selected_retrieval_runtime",
    "telemetry_fields",
    "candidate_fields",
    "evidence_ref_fields",
    "policy_snapshot_fields",
    "allowed_evidence_ref_types",
    "allowed_candidate_types",
    "allowed_surface_labels",
    "required_reason_codes",
    "required_followups",
    "blocked_payloads",
    "blocked_backends",
    "blocked_policy_decisions"
  ],
  "properties": {
    "gate_status": {
      "const": "closed"
    },
    "runtime_allowed": {
      "const": false
    },
    "implementation_allowed": {
      "const": false
    },
    "admission_allowed": {
      "const": false
    },
    "embedding_allowed": {
      "const": false
    },
    "retrieval_runtime_allowed": {
      "const": false
    },
    "semantic_similarity_allowed": {
      "const": false
    },
    "vector_search_allowed": {
      "const": false
    },
    "provider_calls_allowed": {
      "const": false
    },
    "provider_wiring_allowed": {
      "const": false
    },
    "cache_read_allowed": {
      "const": false
    },
    "cache_write_allowed": {
      "const": false
    },
    "serving_allowed": {
      "const": false
    },
    "model_downgrade_allowed": {
      "const": false
    },
    "pricing_truth_allowed": {
      "const": false
    },
    "telemetry_phase": {
      "const": "PR-O4"
    },
    "authority_boundary": {
      "const": "metadata_only_non_serving"
    },
    "asset_type": {
      "const": "embedding_retrieval_admission_telemetry"
    },
    "selected_embedding_backend": {
      "const": "none"
    },
    "selected_retrieval_runtime": {
      "const": "none"
    },
    "telemetry_fields": {
      "type": "array",
      "items": {
        "enum": [
          "telemetry_id",
          "telemetry_phase",
          "policy_snapshot_id",
          "evidence_refs",
          "candidates",
          "admission_allowed",
          "embedding_allowed",
          "retrieval_runtime_allowed",
          "semantic_similarity_allowed",
          "vector_search_allowed",
          "provider_calls_allowed",
          "cache_read_allowed",
          "cache_write_allowed",
          "serving_allowed",
          "selected_embedding_backend",
          "selected_retrieval_runtime",
          "required_followups",
          "reason_codes",
          "metadata"
        ]
      },
      "minItems": 19,
      "uniqueItems": true
    },
    "candidate_fields": {
      "type": "array",
      "items": {
        "enum": [
          "candidate_id",
          "candidate_type",
          "surface_label",
          "evidence_ref_ids",
          "admission_state",
          "reason_codes",
          "metadata"
        ]
      },
      "minItems": 7,
      "uniqueItems": true
    },
    "evidence_ref_fields": {
      "type": "array",
      "items": {
        "enum": [
          "ref_id",
          "ref_type",
          "source_path",
          "source_fingerprint",
          "metadata"
        ]
      },
      "minItems": 5,
      "uniqueItems": true
    },
    "policy_snapshot_fields": {
      "type": "array",
      "items": {
        "enum": [
          "policy_id",
          "policy_version",
          "authority_boundary",
          "gate_status",
          "evidence_ref_types",
          "candidate_types",
          "reason_codes",
          "metadata"
        ]
      },
      "minItems": 8,
      "uniqueItems": true
    },
    "allowed_evidence_ref_types": {
      "type": "array",
      "items": {
        "enum": [
          "changed_file",
          "contract",
          "test",
          "agent_rule",
          "review_artifact",
          "roadmap",
          "orchestration_packet"
        ]
      },
      "minItems": 7,
      "uniqueItems": true
    },
    "allowed_candidate_types": {
      "type": "array",
      "items": {
        "enum": [
          "embedding_candidate",
          "retrieval_candidate",
          "hybrid_candidate"
        ]
      },
      "minItems": 3,
      "uniqueItems": true
    },
    "allowed_surface_labels": {
      "type": "array",
      "items": {
        "enum": [
          "orchestration_context",
          "merge_readiness_context",
          "prompt_module_registry",
          "evidence_graph_reference"
        ]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "required_reason_codes": {
      "type": "array",
      "items": {
        "enum": [
          "gate_closed",
          "metadata_only",
          "admission_deferred",
          "no_embeddings",
          "no_vector_search",
          "no_runtime_retrieval",
          "no_provider_call",
          "no_cache_serving",
          "future_gate_required"
        ]
      },
      "minItems": 9,
      "uniqueItems": true
    },
    "required_followups": {
      "type": "array",
      "items": {
        "enum": [
          "semantic_cache_gate_open_pr",
          "embedding_runtime_review",
          "retrieval_runtime_review",
          "false_hit_harness_review"
        ]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "blocked_payloads": {
      "type": "array",
      "items": {
        "enum": [
          "raw_prompts",
          "raw_queries",
          "normalized_queries",
          "raw_context_snippets",
          "raw_model_responses",
          "raw_answers",
          "provider_payloads",
          "embedding_vectors",
          "retrieval_queries",
          "similarity_scores",
          "secrets",
          "credentials",
          "local_paths",
          "account_truth",
          "billing_truth",
          "health_sensitive_payloads"
        ]
      },
      "minItems": 16,
      "uniqueItems": true
    },
    "blocked_backends": {
      "type": "array",
      "items": {
        "enum": [
          "embedding_models",
          "embedding_generation",
          "semantic_similarity",
          "vector_index",
          "vector_search",
          "retrieval_runtime",
          "GraphRAG_runtime",
          "provider_clients",
          "provider_calls",
          "Ollama",
          "Perplexity",
          "Sonar",
          "GPT_client",
          "Redis",
          "GPTCache",
          "DB",
          "OpenAPI",
          "frontend",
          "iOS"
        ]
      },
      "minItems": 19,
      "uniqueItems": true
    },
    "blocked_policy_decisions": {
      "type": "array",
      "items": {
        "enum": [
          "runtime_admission",
          "backend_selection",
          "retrieval_route_selection",
          "cache_read_decisions",
          "cache_write_decisions",
          "serving_decisions",
          "provider_selection",
          "model_selection",
          "final_review_downgrade",
          "billing_decisions",
          "entitlement_decisions",
          "production_cost_claims",
          "live_savings_claims",
          "retrieval_quality_claims"
        ]
      },
      "minItems": 14,
      "uniqueItems": true
    }
  }
}
