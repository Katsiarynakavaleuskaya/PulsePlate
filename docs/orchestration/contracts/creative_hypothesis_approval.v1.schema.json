{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/creative_hypothesis_approval.v1.schema.json",
  "title": "CreativeHypothesisApproval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "policy_version",
    "approval_id",
    "idempotency_key",
    "hypothesis_id",
    "decision",
    "approved_target_surfaces",
    "approved_agents",
    "approved_by",
    "generate_patch",
    "next_step",
    "authority",
    "sanitized"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "creative_hypothesis_approval" },
    "policy_version": { "const": "experiment-runner-pr-creative-context-v1" },
    "approval_id": { "$ref": "#/$defs/safe_id" },
    "idempotency_key": { "$ref": "#/$defs/safe_id" },
    "hypothesis_id": { "$ref": "#/$defs/safe_id" },
    "decision": { "enum": ["approve_for_pr1_specification", "reject", "defer"] },
    "approved_target_surfaces": { "$ref": "#/$defs/repo_paths" },
    "approved_agents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/agent_slug" }
    },
    "approved_by": { "const": "human_operator" },
    "generate_patch": { "const": false },
    "next_step": { "enum": ["create_pr1_specification", "no_action", "defer"] },
    "authority": { "$ref": "#/$defs/authority" },
    "sanitized": { "const": true }
  },
  "allOf": [
    {
      "if": {
        "required": ["decision"],
        "properties": { "decision": { "const": "approve_for_pr1_specification" } }
      },
      "then": {
        "properties": {
          "next_step": { "const": "create_pr1_specification" },
          "approved_target_surfaces": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/approvable_pr1_target_path" }
          }
        }
      }
    },
    {
      "if": {
        "required": ["decision"],
        "properties": { "decision": { "const": "reject" } }
      },
      "then": {
        "properties": {
          "next_step": { "const": "no_action" },
          "approved_target_surfaces": { "maxItems": 0 },
          "approved_agents": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "required": ["decision"],
        "properties": { "decision": { "const": "defer" } }
      },
      "then": {
        "properties": {
          "next_step": { "const": "defer" },
          "approved_target_surfaces": { "maxItems": 0 },
          "approved_agents": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "repo_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-][A-Za-z0-9_./-]*$",
      "not": {
        "pattern": "(^/|\\.\\.|\\\\|file://|^~|^\\.git/|^\\.venv/|^worktrees/|^artifacts(/|$))"
      }
    },
    "approvable_pr1_target_path": {
      "allOf": [
        { "$ref": "#/$defs/repo_path" },
        {
          "pattern": "^(scripts/|tests/|docs/orchestration/|docs/prompts/|tools/codex_skills/|\\.agents/skills/)"
        },
        { "not": { "pattern": "^(app/|core/|frontend/|ios/|providers/|alembic/|\\.github/workflows/)" } }
      ]
    },
    "repo_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repo_path" }
    },
    "agent_slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_product_runtime",
        "call_provider",
        "change_client_runtime",
        "change_openapi",
        "claim_merge_readiness",
        "create_branch",
        "edit_fixed_mapping",
        "emit_local_artifacts",
        "execute_pr1_specification",
        "execute_pr2_patch_builder",
        "execute_pr3_promotion",
        "generate_hypotheses",
        "generate_patch",
        "mark_pr_ready",
        "merge",
        "modify_github_app",
        "modify_slack",
        "modify_workflows",
        "open_draft_pr",
        "open_pr",
        "post_github_comment",
        "prepare_human_approval_packet",
        "push",
        "read_sanitized_context",
        "read_secrets",
        "release",
        "resolve_threads",
        "route_to_agents",
        "use_semantic_cache",
        "workflow_dispatch",
        "write_branch"
      ],
      "properties": {
        "call_product_runtime": { "const": false },
        "call_provider": { "const": false },
        "change_client_runtime": { "const": false },
        "change_openapi": { "const": false },
        "claim_merge_readiness": { "const": false },
        "create_branch": { "const": false },
        "edit_fixed_mapping": { "const": false },
        "emit_local_artifacts": { "const": true },
        "execute_pr1_specification": { "const": false },
        "execute_pr2_patch_builder": { "const": false },
        "execute_pr3_promotion": { "const": false },
        "generate_hypotheses": { "const": true },
        "generate_patch": { "const": false },
        "mark_pr_ready": { "const": false },
        "merge": { "const": false },
        "modify_github_app": { "const": false },
        "modify_slack": { "const": false },
        "modify_workflows": { "const": false },
        "open_draft_pr": { "const": false },
        "open_pr": { "const": false },
        "post_github_comment": { "const": false },
        "prepare_human_approval_packet": { "const": true },
        "push": { "const": false },
        "read_sanitized_context": { "const": true },
        "read_secrets": { "const": false },
        "release": { "const": false },
        "resolve_threads": { "const": false },
        "route_to_agents": { "const": true },
        "use_semantic_cache": { "const": false },
        "workflow_dispatch": { "const": false },
        "write_branch": { "const": false }
      }
    }
  }
}
