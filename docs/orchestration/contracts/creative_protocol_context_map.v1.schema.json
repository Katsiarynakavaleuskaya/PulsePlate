{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/creative_protocol_context_map.v1.schema.json",
  "title": "CreativeProtocolContextMap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "policy_version",
    "context_id",
    "idempotency_key",
    "source",
    "classification",
    "changed_paths",
    "nearby_repo_refs",
    "test_refs",
    "contract_refs",
    "backlog_refs",
    "review_source_refs",
    "capability_state_ref",
    "philosophical_context_refs",
    "cross_domain_candidate_refs",
    "codex_security_review",
    "authority",
    "sanitized"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "creative_protocol_context_map" },
    "policy_version": { "const": "experiment-runner-pr-creative-context-v1" },
    "context_id": { "$ref": "#/$defs/safe_id" },
    "idempotency_key": { "$ref": "#/$defs/safe_id" },
    "source": { "$ref": "#/$defs/source" },
    "classification": { "$ref": "#/$defs/classification" },
    "changed_paths": { "$ref": "#/$defs/repo_paths" },
    "nearby_repo_refs": { "$ref": "#/$defs/repo_paths" },
    "test_refs": { "$ref": "#/$defs/repo_paths" },
    "contract_refs": { "$ref": "#/$defs/repo_paths" },
    "backlog_refs": { "$ref": "#/$defs/repo_paths" },
    "review_source_refs": { "$ref": "#/$defs/artifact_refs_or_repo_paths" },
    "capability_state_ref": {
      "anyOf": [{ "$ref": "#/$defs/artifact_ref" }, { "type": "null" }]
    },
    "philosophical_context_refs": { "$ref": "#/$defs/repo_paths" },
    "cross_domain_candidate_refs": { "$ref": "#/$defs/repo_paths" },
    "codex_security_review": { "$ref": "#/$defs/codex_security_review" },
    "authority": { "$ref": "#/$defs/authority" },
    "sanitized": { "const": true }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "repo_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-][A-Za-z0-9_./-]*$",
      "not": { "pattern": "(^/|\\.\\.|\\\\|file://|^~|^\\.git/|^\\.venv/|^worktrees/)" }
    },
    "repo_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repo_path" }
    },
    "artifact_ref": {
      "type": "string",
      "pattern": "^artifacts/orchestration/(experiments|creative_code)/[A-Za-z0-9_./:-]+$"
    },
    "artifact_refs_or_repo_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [{ "$ref": "#/$defs/repo_path" }, { "$ref": "#/$defs/artifact_ref" }]
      }
    },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pr_number",
        "base_ref",
        "base_sha",
        "head_sha",
        "task_packet_id",
        "generated_at_utc"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "pr_number": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "base_ref": { "type": "string", "minLength": 1, "maxLength": 192 },
        "base_sha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "head_sha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "task_packet_id": { "anyOf": [{ "$ref": "#/$defs/safe_id" }, { "type": "null" }] },
        "generated_at_utc": {
          "anyOf": [{ "$ref": "#/$defs/utc_timestamp" }, { "type": "null" }]
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "creative_decision",
        "reason_code",
        "activation_source",
        "eligible_surface"
      ],
      "properties": {
        "eligible": { "type": "boolean" },
        "creative_decision": {
          "enum": ["hypotheses_required", "no_creative_action", "blocked"]
        },
        "reason_code": { "type": "string" },
        "activation_source": { "enum": ["path", "label", "marker", "manual", "none"] },
        "eligible_surface": { "type": "string" }
      }
    },
    "codex_security_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "sealed_scan_ref",
        "sealed_scan_fingerprint",
        "security_relevant_diff_changed",
        "rerun_allowed_reasons"
      ],
      "properties": {
        "policy": { "const": "single_pass_per_material_diff" },
        "sealed_scan_ref": {
          "anyOf": [{ "$ref": "#/$defs/artifact_ref" }, { "type": "null" }]
        },
        "sealed_scan_fingerprint": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "security_relevant_diff_changed": { "type": "boolean" },
        "rerun_allowed_reasons": {
          "const": [
            "security_relevant_diff_changed",
            "coordinator_evidence_backed_reroute",
            "operator_explicit_request",
            "scan_artifact_failed_or_incomplete"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "generate_hypotheses": { "const": true },
        "route_to_agents": { "const": true },
        "generate_patch": { "const": false },
        "write_branch": { "const": false },
        "push": { "const": false },
        "merge": { "const": false },
        "call_provider": { "const": false },
        "modify_workflows": { "const": false }
      },
      "additionalProperties": { "type": "boolean" }
    }
  }
}
