{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/creative_hypothesis_coordinator_dispatch.v1.schema.json",
  "title": "CreativeHypothesisCoordinatorDispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "policy_version",
    "dispatch_id",
    "idempotency_key",
    "source_hypothesis_packet_id",
    "source_hypothesis_packet_fingerprint",
    "dispatch",
    "authority",
    "sanitized"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "creative_hypothesis_coordinator_dispatch" },
    "policy_version": { "const": "creative-hypothesis-coordinator-dispatch-v1" },
    "dispatch_id": { "$ref": "#/$defs/safe_id" },
    "idempotency_key": { "$ref": "#/$defs/safe_id" },
    "source_hypothesis_packet_id": { "$ref": "#/$defs/safe_id" },
    "source_hypothesis_packet_fingerprint": { "$ref": "#/$defs/sha256" },
    "dispatch": {
      "type": "array",
      "items": { "$ref": "#/$defs/dispatch_entry" }
    },
    "authority": { "$ref": "#/$defs/dispatch_authority" },
    "sanitized": { "const": true }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "agent_slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "dispatch_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "task_packet_kind",
        "primary_agent",
        "review_agents",
        "cross_domain_agents",
        "missing_agent_capabilities",
        "task_mode",
        "mutation_authority",
        "coordinator_decision_required"
      ],
      "properties": {
        "hypothesis_id": { "$ref": "#/$defs/safe_id" },
        "task_packet_kind": { "const": "TASK_PACKET_V1" },
        "primary_agent": { "$ref": "#/$defs/agent_slug" },
        "review_agents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agent_slug" }
        },
        "cross_domain_agents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agent_slug" }
        },
        "missing_agent_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agent_slug" }
        },
        "task_mode": { "const": "critique_refine_only" },
        "mutation_authority": { "const": false },
        "coordinator_decision_required": { "const": true }
      }
    },
    "dispatch_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_product_runtime",
        "call_provider",
        "change_client_runtime",
        "change_openapi",
        "claim_merge_readiness",
        "create_branch",
        "dispatch_to_coordinator",
        "edit_fixed_mapping",
        "execute_agent_tasks",
        "execute_pr1_specification",
        "execute_pr2_patch_builder",
        "execute_pr3_promotion",
        "generate_patch",
        "mark_pr_ready",
        "merge",
        "modify_github_app",
        "modify_slack",
        "modify_workflows",
        "mutate_code",
        "open_draft_pr",
        "open_pr",
        "post_github_comment",
        "push",
        "read_secrets",
        "release",
        "resolve_threads",
        "use_semantic_cache",
        "workflow_dispatch",
        "write_branch"
      ],
      "properties": {
        "call_product_runtime": { "const": false },
        "call_provider": { "const": false },
        "change_client_runtime": { "const": false },
        "change_openapi": { "const": false },
        "claim_merge_readiness": { "const": false },
        "create_branch": { "const": false },
        "dispatch_to_coordinator": { "const": true },
        "edit_fixed_mapping": { "const": false },
        "execute_agent_tasks": { "const": false },
        "execute_pr1_specification": { "const": false },
        "execute_pr2_patch_builder": { "const": false },
        "execute_pr3_promotion": { "const": false },
        "generate_patch": { "const": false },
        "mark_pr_ready": { "const": false },
        "merge": { "const": false },
        "modify_github_app": { "const": false },
        "modify_slack": { "const": false },
        "modify_workflows": { "const": false },
        "mutate_code": { "const": false },
        "open_draft_pr": { "const": false },
        "open_pr": { "const": false },
        "post_github_comment": { "const": false },
        "push": { "const": false },
        "read_secrets": { "const": false },
        "release": { "const": false },
        "resolve_threads": { "const": false },
        "use_semantic_cache": { "const": false },
        "workflow_dispatch": { "const": false },
        "write_branch": { "const": false }
      }
    }
  }
}
