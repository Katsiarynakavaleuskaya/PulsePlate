{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseplate.local/contracts/creative_code_candidate.v1.schema.json",
  "title": "CreativeCodeCandidatePacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_type",
    "candidate_id",
    "idempotency_key",
    "policy_version",
    "gate_status",
    "authority_class",
    "source_creative_research",
    "variant_count",
    "sandbox_required",
    "human_review_required",
    "fallback",
    "target_surface",
    "immutable_oracles",
    "authority",
    "scientific_claim_status",
    "evidence_bundle",
    "future_telemetry_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "packet_type": {
      "const": "creative_code_candidate"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "policy_version": {
      "const": "creative-code-authority-pr0"
    },
    "gate_status": {
      "const": "closed"
    },
    "authority_class": {
      "const": "code-specification"
    },
    "source_creative_research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "candidate_id",
        "promotion_decision",
        "fingerprint",
        "evidence_ref"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "promotion_decision": {
          "const": "promote"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "variant_count": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5
    },
    "sandbox_required": {
      "const": true
    },
    "human_review_required": {
      "const": true
    },
    "fallback": {
      "type": "string",
      "minLength": 1
    },
    "target_surface": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "immutable_oracles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generate_specifications",
        "generate_candidate_patch",
        "write_repository",
        "write_shared_worktree",
        "create_branch",
        "push_branch",
        "open_pull_request",
        "open_draft_pr",
        "mark_ready_for_review",
        "resolve_review_threads",
        "merge",
        "release",
        "call_models",
        "call_network",
        "read_secrets",
        "modify_openapi_or_clients",
        "use_semantic_cache",
        "public_multi_tenant_use",
        "slack_github_authority_expansion"
      ],
      "properties": {
        "generate_specifications": {
          "const": true
        },
        "generate_candidate_patch": {
          "const": false
        },
        "write_repository": {
          "const": false
        },
        "write_shared_worktree": {
          "const": false
        },
        "create_branch": {
          "const": false
        },
        "push_branch": {
          "const": false
        },
        "open_pull_request": {
          "const": false
        },
        "open_draft_pr": {
          "const": false
        },
        "mark_ready_for_review": {
          "const": false
        },
        "resolve_review_threads": {
          "const": false
        },
        "merge": {
          "const": false
        },
        "release": {
          "const": false
        },
        "call_models": {
          "const": false
        },
        "call_network": {
          "const": false
        },
        "read_secrets": {
          "const": false
        },
        "modify_openapi_or_clients": {
          "const": false
        },
        "use_semantic_cache": {
          "const": false
        },
        "public_multi_tenant_use": {
          "const": false
        },
        "slack_github_authority_expansion": {
          "const": false
        }
      }
    },
    "scientific_claim_status": {
      "enum": [
        "hypothesis_only",
        "evidence_supported_plan",
        "inconclusive"
      ]
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_refs",
        "required_tests",
        "negative_controls"
      ],
      "properties": {
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "future_telemetry_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emit_no_earlier_than",
        "minimum_fields"
      ],
      "properties": {
        "emit_no_earlier_than": {
          "const": "PR-1"
        },
        "minimum_fields": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "packet_id",
              "source_candidate_id",
              "variant_count",
              "generation_status",
              "oracle_status",
              "failure_class",
              "human_decision",
              "cost_metadata_available"
            ]
          }
        }
      }
    }
  }
}
