{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PHILOSOPHY_SOURCE_CORPUS_INDEX.schema.json",
  "title": "Philosophy Source Corpus Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "generated_at",
    "rollout_phase",
    "gate_status",
    "runtime_allowed",
    "implementation_allowed",
    "requires_dedicated_gate",
    "semantic_cache_markers",
    "source_policy",
    "source_count",
    "total_pages",
    "sources",
    "research_basis",
    "repo_truth_links",
    "out_of_scope_paths"
  ],
  "properties": {
    "contract_id": {
      "const": "philosophy_source_corpus_index"
    },
    "contract_version": {
      "const": "2026-05-24"
    },
    "generated_at": {
      "const": "static-2026-05-24"
    },
    "rollout_phase": {
      "const": "PHILOSOPHY-PR5"
    },
    "gate_status": {
      "const": "closed"
    },
    "runtime_allowed": {
      "const": false
    },
    "implementation_allowed": {
      "const": false
    },
    "requires_dedicated_gate": {
      "const": true
    },
    "semantic_cache_markers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_status_closed",
        "runtime_allowed_false",
        "implementation_allowed_false",
        "dedicated_gate_required"
      ],
      "properties": {
        "gate_status_closed": {
          "const": true
        },
        "runtime_allowed_false": {
          "const": true
        },
        "implementation_allowed_false": {
          "const": true
        },
        "dedicated_gate_required": {
          "const": true
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "local_path_policy",
        "text_policy",
        "promotion_policy",
        "credential_policy",
        "wellness_boundary"
      ],
      "properties": {
        "authority": {
          "const": "operator_pdf_design_evidence_repo_truth_wins"
        },
        "local_path_policy": {
          "const": "no_absolute_local_paths_committed"
        },
        "text_policy": {
          "const": "metadata_and_paraphrase_only_no_full_pdf_text"
        },
        "promotion_policy": {
          "const": "not_runtime_truth_without_reviewed_contract"
        },
        "credential_policy": {
          "const": "credential_like_urls_forbidden"
        },
        "wellness_boundary": {
          "const": "cbt_inspired_reflective_wellness_coaching_not_medical_diagnosis_treatment_or_therapy"
        }
      }
    },
    "source_count": {
      "const": 6
    },
    "total_pages": {
      "const": 102
    },
    "sources": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "sanitized_filename",
          "language",
          "page_count",
          "sha256",
          "source_family",
          "extraction_status",
          "summary",
          "theme_families",
          "discipline_rails",
          "linked_repo_anchors",
          "future_handoff",
          "runtime_flags"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "sanitized_filename": {
            "type": "string",
            "minLength": 8
          },
          "language": {
            "const": "ru"
          },
          "page_count": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{8}){7}$"
          },
          "source_family": {
            "type": "string",
            "enum": [
              "socratic_cbt_semantic_cache",
              "leibniz_information_theory",
              "analytic_linguistic_audit",
              "full_philosophy_roadmap",
              "philosophy_cbt_correlation",
              "philosophy_cbt_plan_adaptation"
            ]
          },
          "extraction_status": {
            "const": "metadata_and_text_extract_verified"
          },
          "summary": {
            "type": "string",
            "minLength": 40
          },
          "theme_families": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "discipline_rails": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "enum": [
                "philosophy",
                "linguistics",
                "cbt_coaching",
                "information_theory",
                "mathematics",
                "ai_governance",
                "wellness_product"
              ]
            }
          },
          "linked_repo_anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "future_handoff": {
            "type": "string",
            "minLength": 20
          },
          "runtime_flags": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cache_read_allowed",
              "cache_write_allowed",
              "serving_allowed",
              "runtime_activation_allowed",
              "provider_call_allowed",
              "insight_route_change_allowed"
            ],
            "properties": {
              "cache_read_allowed": {
                "const": false
              },
              "cache_write_allowed": {
                "const": false
              },
              "serving_allowed": {
                "const": false
              },
              "runtime_activation_allowed": {
                "const": false
              },
              "provider_call_allowed": {
                "const": false
              },
              "insight_route_change_allowed": {
                "const": false
              }
            }
          }
        }
      }
    },
    "research_basis": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "url",
          "rail",
          "source_kind",
          "accessed_on",
          "verification_status",
          "boundary_note",
          "use"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "rail": {
            "type": "string"
          },
          "source_kind": {
            "type": "string"
          },
          "accessed_on": {
            "type": "string"
          },
          "verification_status": {
            "type": "string"
          },
          "boundary_note": {
            "type": "string"
          },
          "use": {
            "const": "rationale_only_not_runtime_truth"
          }
        }
      }
    },
    "repo_truth_links": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "string"
      }
    },
    "out_of_scope_paths": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "string"
      }
    }
  }
}
