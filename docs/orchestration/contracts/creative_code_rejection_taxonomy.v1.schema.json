        "stage",
        "severity",
        "retryability",
        "likely_owner"
      ],
      "properties": {
        "code": {
          "enum": [
            "approval_missing",
            "base_drift",
            "branch_exists",
            "capability_mismatch",
            "duplicate_variant",
            "github_transport_failed",
            "guard_failure",
            "infra_flake",
            "invalid_input",
            "leak_detected",
            "lineage_mismatch",
            "malformed_artifact",
            "metric_regression",
            "oom",
            "patch_drift",
            "policy_violation",
            "pr_readback_failed",
            "review_blocker",
            "specification_rejected",
            "timeout",
            "unchanged_result",
            "unknown",
            "unsafe_authority"
          ]
        },
        "stage": {
          "enum": [
            "specification",
            "patch_evaluation",
            "promotion_plan",
            "promotion_validation",
            "promotion_approval",
            "pr_open",
            "artifact_read_error"
          ]
