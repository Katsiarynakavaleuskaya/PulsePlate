{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PulsePlateAgentEvent",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "task_id",
    "agent_id",
    "event_type",
    "status"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "task_created",
        "packet_emitted",
        "execution_started",
        "execution_finished",
        "verification_passed",
        "verification_failed",
        "promotion_proposed",
        "promotion_rejected",
        "promotion_accepted",
        "incident_detected"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ]
    },
    "branch": {
      "type": "string"
    },
    "sha": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "message": {
      "type": "string"
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "human_approval_required": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}
