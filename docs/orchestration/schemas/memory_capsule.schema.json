{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PulsePlateMemoryCapsule",
  "type": "object",
  "required": [
    "capsule_id",
    "memory_type",
    "title",
    "summary",
    "sources",
    "confidence",
    "promotion_status"
  ],
  "properties": {
    "capsule_id": {
      "type": "string",
      "minLength": 1
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "canonical",
        "working",
        "advisory",
        "historical"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "promotion_status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "rejected",
        "archived"
      ]
    },
    "owner": {
      "type": "string"
    },
    "linked_task_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
