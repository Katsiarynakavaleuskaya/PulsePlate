{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PulsePlateReflectionPacket",
  "type": "object",
  "required": [
    "reflection_id",
    "task_id",
    "owner",
    "context",
    "what_worked",
    "what_failed",
    "root_cause",
    "repeat_risk",
    "proposed_improvement",
    "promotion_target",
    "human_review_required"
  ],
  "properties": {
    "reflection_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "what_worked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "what_failed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "root_cause": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "repeat_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "proposed_improvement": {
      "type": "object",
      "required": [
        "kind",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "docs",
            "rule",
            "schema",
            "tooling",
            "process"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "promotion_target": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "human_review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "additionalProperties": false
}
