{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PulsePlateActionPacket",
  "type": "object",
  "required": [
    "task_id",
    "track",
    "owner",
    "agent_role",
    "objective",
    "scope_in",
    "scope_out",
    "constraints",
    "risk_class",
    "verification",
    "promotion_target"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "type": "string",
      "enum": [
        "delivery",
        "workforce",
        "research",
        "design",
        "ops"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "agent_role": {
      "type": "string",
      "minLength": 1
    },
    "requested_agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope_in": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "promotion_target": {
      "type": "object",
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "docs",
            "rules",
            "schema",
            "tooling",
            "pr",
            "artifact"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "additionalProperties": false
}
