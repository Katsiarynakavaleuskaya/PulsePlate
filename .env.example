# === LLM Provider Settings ===
LLM_PROVIDER=grok
XAI_API_KEY=replace_me

# === Grok API ===
GROK_MODEL=grok-4-latest
GROK_ENDPOINT=https://api.x.ai/v1
GROK_RPS=1
GROK_RPM=60
GROK_MAX_RETRIES=3
GROK_BACKOFF_MS=300

# === Ollama Local ===
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# === App Environment ===
APP_ENV=local

# === Required secrets (local/dev) ===
# SERVER_SALT is required at app startup for VIP LLM monthly quota enforcement.
SERVER_SALT=replace_me_with_secret

# === VIP LLM quota (requests/month) ===
# Optional: defaults to 30 if unset; must be an integer >= 1 if set.
VIP_LLM_INSIGHT_REQUESTS_PER_MONTH=30

# === API Keys ===
# Provide your API key in real deployments via environment variables.
# Leaving this empty keeps the app in lenient dev mode.
API_KEY=
ALLOW_DEV_API_KEY=true
