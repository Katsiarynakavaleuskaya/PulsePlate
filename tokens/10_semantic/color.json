{
  "semantic": {
    "color": {
      "primary": { "$type": "color", "$value": "#339FFF" },
      "primaryForeground": { "$type": "color", "$value": "#FFFFFF" },
      "bg": { "$type": "color", "$value": "#FFFFFF" },
      "surface": { "$type": "color", "$value": "#F0F4F8" },
      "surfaceMuted": { "$type": "color", "$value": "#D9E2EC" },
