      "info": { "$type": "color", "$value": "#60A5FA" },
      "focus": { "$type": "color", "$value": "#60A5FA" },
      "focusRgb": { "$type": "string", "$value": "96, 165, 250" },
      "focusShadow": {
        "$type": "string",
