      "success": { "$type": "color", "$value": "#20C997" },
      "warning": { "$type": "color", "$value": "#F59E0B" },
      "error": { "$type": "color", "$value": "#FF5D5D" },
      "info": { "$type": "color", "$value": "#339FFF" },
      "focus": { "$type": "color", "$value": "#339FFF" },
      "focusRgb": { "$type": "string", "$value": "51, 159, 255" },
