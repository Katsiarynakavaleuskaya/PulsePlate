{
  "typography": {
    "fontFamily": {
      "sans": { "$type": "string", "$value": "Inter, system-ui, sans-serif" },
      "mono": { "$type": "string", "$value": "JetBrains Mono, Consolas, monospace" }
    },
    "fontSize": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "xl": { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem" },
      "3xl": { "$type": "dimension", "$value": "1.875rem" },
      "4xl": { "$type": "dimension", "$value": "2.25rem" },
      "5xl": { "$type": "dimension", "$value": "3rem" }
    },
    "fontWeight": {
      "light": { "$type": "string", "$value": "300" },
      "normal": { "$type": "string", "$value": "400" },
      "medium": { "$type": "string", "$value": "500" },
      "semibold": { "$type": "string", "$value": "600" },
      "bold": { "$type": "string", "$value": "700" }
    },
    "lineHeight": {
      "tight": { "$type": "string", "$value": "1.25" },
      "snug": { "$type": "string", "$value": "1.375" },
      "normal": { "$type": "string", "$value": "1.5" },
      "relaxed": { "$type": "string", "$value": "1.625" },
      "loose": { "$type": "string", "$value": "2" }
    },
    "textStyle": {
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": "600",
          "lineHeight": "1.25"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": "400",
          "lineHeight": "1.5"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": "400",
          "lineHeight": "1.375",
          "fontSize": "0.875rem"
        }
      }
    }
  }
}
