[tool.ruff]
line-length = 100
target-version = "py310"

[tool.ruff.lint]
# включаем базовые наборы Pycodestyle/Pyflakes + isort-проверки
select = ["E", "F", "W", "I"]

[tool.ruff.lint.isort]
known-first-party = ["app", "bmi_core"]

# ровно то, что нужно сейчас: заглушаем E402 ТОЛЬКО в tests_strict
[tool.ruff.lint.per-file-ignores]
"tests_strict/*.py" = ["E402"]

[tool.pytest.ini_options]
pythonpath = "."
addopts = "-q"
asyncio_mode = "auto"
