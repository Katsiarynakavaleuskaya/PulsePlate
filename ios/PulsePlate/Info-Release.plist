<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Strict ATS for Release builds - HTTPS only -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<false/>
	</dict>
	<!-- Production configuration -->
	<!-- SECURITY WARNING: DO NOT store API keys or secrets in Info.plist -->
	<!-- For production keys, use the existing ProKeyProvider.swift Keychain pattern -->
	<!-- See: ios/PulsePlate/Services/ProKeyProvider.swift for secure storage implementation -->
	<!-- For CI/CD: Inject secrets via build environment or secure provisioning -->
	<!-- Operator decision (PR-7): canonical_release_base_url = https://pulseplate.app -->
	<key>BASE_URL</key>
	<string>https://pulseplate.app</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>NSHealthShareUsageDescription</key>
	<string>PulsePlate reads Health nutrition and body weight data to show wellness progress and planning with your consent.</string>
</dict>
</plist>
