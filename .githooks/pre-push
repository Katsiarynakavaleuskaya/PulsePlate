#!/bin/sh
#
# Pre-push hook: Block push if there are unresolved merge conflicts
#
# This hook prevents pushing code with unresolved merge conflicts,
# conflict markers, or partially resolved merges.
#
# See: AGENTS.md section "Merge Conflict Safety (Hard Rule)"

set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "Checking for merge conflicts before push..."

# 1. Check git index for unmerged paths
unmerged=$(git ls-files -u)
if [ -n "$unmerged" ]; then
    echo "${RED}❌ Push blocked: unresolved merge conflicts detected.${NC}"
    echo ""
    echo "Unmerged files:"
    echo "$unmerged" | awk '{print "  - " $4}'
    echo ""
    echo "Resolve all conflicts before pushing:"
    echo "  1. Resolve conflicts in files listed above"
    echo "  2. Run: git add <resolved-files>"
    echo "  3. Run: git commit (or git rebase --continue / git merge --continue)"
    echo "  4. Verify: git status shows clean working tree"
    exit 1
fi

# 2. Check for conflict markers in working tree (staged + unstaged)
# Exclude files that contain conflict-checking code (false positives)
exclude_files="\.github/workflows/ci\.yml|\.githooks/pre-push|docs/MERGE_CONFLICT_SAFETY_SETUP\.md|\.pre-commit-config\.yaml"
# NUL-safe pipeline for staged files
staged_paths="$(
  git diff --cached --name-only -z 2>/dev/null \
  | grep -z -vE "$exclude_files" \
  | tr '\0' '\n' || true
)"
conflict_markers=""
if [ -n "$staged_paths" ]; then
    conflict_markers="$(
      git diff --cached --name-only -z 2>/dev/null \
      | grep -z -vE "$exclude_files" \
      | xargs -0 git grep -l '<<<<<<< HEAD\|=======\|>>>>>>>' -- 2>/dev/null || true
    )"
fi
if [ -n "$conflict_markers" ]; then
    echo "${RED}❌ Push blocked: conflict markers found in staged files.${NC}"
    echo ""
    echo "Files with conflict markers:"
    echo "$conflict_markers" | sed 's/^/  - /'
    echo ""
    echo "Remove all conflict markers before pushing."
    exit 1
fi

# Check unstaged files too (exclude conflict-checking code files)
# NUL-safe pipeline for unstaged files
unstaged_paths="$(
  git diff --name-only -z 2>/dev/null \
  | grep -z -vE "$exclude_files" \
  | tr '\0' '\n' || true
)"
conflict_markers_unstaged=""
if [ -n "$unstaged_paths" ]; then
    conflict_markers_unstaged="$(
      git diff --name-only -z 2>/dev/null \
      | grep -z -vE "$exclude_files" \
      | xargs -0 git grep -l '<<<<<<< HEAD\|=======\|>>>>>>>' -- 2>/dev/null || true
    )"
fi
if [ -n "$conflict_markers_unstaged" ]; then
    echo "${YELLOW}⚠️  Warning: conflict markers found in unstaged files.${NC}"
    echo ""
    echo "Files with conflict markers:"
    echo "$conflict_markers_unstaged" | sed 's/^/  - /'
    echo ""
    echo "These files are not staged, but should be resolved before pushing."
    echo "Consider: git add <files> and resolve conflicts, or git restore <files>"
fi

# 3. Check for merge/rebase in progress
if [ -f .git/MERGE_HEAD ] || [ -f .git/REBASE_HEAD ] || [ -f .git/CHERRY_PICK_HEAD ]; then
    echo "${RED}❌ Push blocked: merge/rebase/cherry-pick in progress.${NC}"
    echo ""
    if [ -f .git/MERGE_HEAD ]; then
        echo "Merge in progress. Complete or abort:"
        echo "  git merge --continue  (if conflicts resolved)"
        echo "  git merge --abort     (to cancel)"
    fi
    if [ -f .git/REBASE_HEAD ]; then
        echo "Rebase in progress. Complete or abort:"
        echo "  git rebase --continue  (if conflicts resolved)"
        echo "  git rebase --abort     (to cancel)"
    fi
    if [ -f .git/CHERRY_PICK_HEAD ]; then
        echo "Cherry-pick in progress. Complete or abort:"
        echo "  git cherry-pick --continue  (if conflicts resolved)"
        echo "  git cherry-pick --abort     (to cancel)"
    fi
    exit 1
fi

echo "✅ No merge conflicts detected. Push allowed."
exit 0
