#!/usr/bin/env bash

# Pre-commit hook: runs smoke tests first, then pre-commit framework checks
# To enable: git config core.hooksPath .githooks

set -euo pipefail

if [[ "${SKIP_PRECOMMIT_TESTS:-0}" == "1" ]]; then
  echo "⚠️  SKIP_PRECOMMIT_TESTS=1 set, skipping pre-commit smoke tests."
  exit 0
fi

if [[ "${CI:-}" == "true" ]]; then
  exit 0
fi

# Step 1: Run lightweight smoke tests first (fast)
echo "📋 Step 1/2: Running smoke tests..."
scripts/precommit_smoke.sh

# Step 2: Run pre-commit framework (black, ruff, etc.)
echo "📋 Step 2/2: Running pre-commit checks (black, ruff, etc.)..."
if command -v pre-commit >/dev/null 2>&1; then
  STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
  if [[ -n "$STAGED_FILES" ]]; then
    pre-commit run --files $STAGED_FILES
  else
    echo "ℹ️  No staged files to check"
  fi
else
  echo "⚠️  pre-commit not installed, skipping format/lint checks"
fi

echo "✅ All pre-commit checks passed!"
