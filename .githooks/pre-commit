#!/usr/bin/env bash
set -euo pipefail

# Bash version check: require 4.3+ for advanced features (nameref, etc.)
if [ "${BASH_VERSINFO[0]}" -lt 4 ] || \
   ([ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 3 ]); then
    echo "❌ Error: This script requires Bash 4.3 or higher" >&2
    echo "   Current version: ${BASH_VERSION}" >&2
    echo "" >&2
    echo "   On macOS, install a newer bash:" >&2
    echo "     brew install bash" >&2
    exit 1
fi

# Enhanced pre-commit hook with comprehensive checks
echo "🔍 Running pre-commit checks..."

# 1. Clean Python cache files
echo "🧹 Cleaning cache files..."
# Use Homebrew bash explicitly to support nameref (requires Bash 4.3+)
# Check Apple Silicon (/opt/homebrew), then Intel (/usr/local), then system bash
if [ -x /opt/homebrew/bin/bash ]; then
    BASH_BIN=/opt/homebrew/bin/bash
elif [ -x /usr/local/bin/bash ]; then
    BASH_BIN=/usr/local/bin/bash
else
    BASH_BIN=bash
fi

if ! $BASH_BIN ./scripts/clean-cache.sh > /dev/null 2>&1; then
    echo "⚠️  Warning: Cache cleanup script failed"
fi

# 2. Check if any cache files are staged
CACHE_FILES=$(git diff --cached --name-only | grep -E '(__pycache__|\.pyc$|\.pyo$|\.pyd$|\.pytest_cache/|\.mypy_cache/|\.ruff_cache/|\.hypothesis/)' || true)

if [ -n "$CACHE_FILES" ]; then
    echo "❌ Cache files detected in staged changes:"
    echo "$CACHE_FILES"
    echo ""
    echo "Please run: ./scripts/clean-cache.sh"
    echo "Then: git add . && git commit"
    exit 1
fi

# 3. Check for frontend changes and run tests
FRONTEND_CHANGES=$(git diff --cached --name-only | grep -E "^frontend/(src/|package\.json)" || true)

if [ -n "$FRONTEND_CHANGES" ]; then
    echo "🎨 Frontend changes detected, running tests..."

    # Check if we're in the right directory
    if [ ! -f "frontend/package.json" ]; then
        echo "⚠️  Warning: frontend/package.json not found, skipping frontend tests"
    else
        cd frontend

        # Run linting
        echo "🔍 Running ESLint..."
        if ! npm run lint --if-present; then
            echo "❌ ESLint failed. Please fix linting errors before committing."
            exit 1
        fi

        # Run type checking
        echo "🔍 Running TypeScript type check..."
        if ! npm run type-check --if-present; then
            echo "❌ TypeScript type check failed. Please fix type errors before committing."
            exit 1
        fi

        # Run tests for changed files
        echo "🧪 Running tests for changed files..."
        declare -a CHANGED_TEST_FILES=()
        for file in $FRONTEND_CHANGES; do
            # Consider only TS/TSX under frontend/src/
            if [[ $file =~ ^frontend/src/(.+)\.(ts|tsx)$ ]]; then
                rel="${BASH_REMATCH[1]}"   # path without extension, may include ".test"
                ext="${BASH_REMATCH[2]}"
                # If the changed file is a test, run it; otherwise, map to its sibling test file.
                if [[ "$rel" == *.test ]]; then
                    test_file="src/${rel}.${ext}"
                else
                    test_file="src/${rel}.test.${ext}"
                fi
                if [ -f "$test_file" ]; then
                    CHANGED_TEST_FILES+=("$test_file")
                fi
            fi
        done

        # Run specific tests if any, otherwise run all tests
        if [ ${#CHANGED_TEST_FILES[@]} -gt 0 ]; then
            echo "Running tests for: ${CHANGED_TEST_FILES[*]}"
            if ! npm run test --if-present -- --run "${CHANGED_TEST_FILES[@]}"; then
                echo "❌ Tests failed. Please fix failing tests before committing."
                exit 1
            fi
        else
            echo "Running all tests..."
            if ! npm run test --if-present -- --run; then
                echo "❌ Tests failed. Please fix failing tests before committing."
                exit 1
            fi
        fi

        cd ..
    fi
fi

# 4. Check for Python changes and run basic checks
PYTHON_CHANGES=$(git diff --cached --name-only | grep "\.py$" || true)

if [ -n "$PYTHON_CHANGES" ]; then
    echo "🐍 Python changes detected, running basic checks..."

    # Auto-format with Black (project standard)
    echo "🎨 Auto-formatting Python code with Black..."
    if command -v black > /dev/null 2>&1; then
        # Filter to only existing files
        EXISTING_PY_FILES=()
        for f in $PYTHON_CHANGES; do
            [ -f "$f" ] && EXISTING_PY_FILES+=("$f")
        done
        if [ ${#EXISTING_PY_FILES[@]} -gt 0 ] && black "${EXISTING_PY_FILES[@]}"; then
            echo "✅ Black formatting applied"
            git add "${EXISTING_PY_FILES[@]}"
        else
            echo "⚠️  Warning: Black formatting failed, continuing..."
        fi
    else
        echo "⚠️  Warning: Black not found, skipping auto-formatting"
        echo "   Install with: pip install black"
    fi

    # Check Python syntax
    for file in $PYTHON_CHANGES; do
        if [ -f "$file" ]; then
            echo "Checking syntax: $file"
            if ! python -m py_compile "$file"; then
                echo "❌ Python syntax error in $file"
                exit 1
            fi
        fi
    done
fi

echo "✅ All pre-commit checks passed!"
exit 0
