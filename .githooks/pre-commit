#!/usr/bin/env bash
set -euo pipefail

# Bash version check: require 4.3+ for advanced features (nameref, etc.)
if [ "${BASH_VERSINFO[0]}" -lt 4 ] || \
   ([ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 3 ]); then
    echo "❌ Error: This script requires Bash 4.3 or higher" >&2
    echo "   Current version: ${BASH_VERSION}" >&2
    echo "" >&2
    echo "   On macOS, install a newer bash:" >&2
    echo "     brew install bash" >&2
    exit 1
fi

# Enhanced pre-commit hook with comprehensive checks
echo "🔍 Running pre-commit checks..."

# 1. Clean Python cache files
echo "🧹 Cleaning cache files..."
# Use Homebrew bash explicitly to support nameref (requires Bash 4.3+)
# Selects the preferred Bash interpreter (Apple Silicon/Homebrew/system)
# Check Apple Silicon (/opt/homebrew), then Intel (/usr/local), then system bash
if [ -x /opt/homebrew/bin/bash ]; then
    BASH_BIN=/opt/homebrew/bin/bash
elif [ -x /usr/local/bin/bash ]; then
    BASH_BIN=/usr/local/bin/bash
else
    BASH_BIN=bash
fi

# Verify Bash version (requires 4.3+ for nameref support)
# Validates the selected binary's version (they can differ)
# Both checks are necessary because the running shell and targeted bash binary may not be the same
BASH_VERSION_OUTPUT=$($BASH_BIN --version 2>&1 | head -n1)
if [[ $BASH_VERSION_OUTPUT =~ version\ ([0-9]+)\.([0-9]+) ]]; then
    BASH_MAJOR="${BASH_REMATCH[1]}"
    BASH_MINOR="${BASH_REMATCH[2]}"
    if [ "$BASH_MAJOR" -lt 4 ] || { [ "$BASH_MAJOR" -eq 4 ] && [ "$BASH_MINOR" -lt 3 ]; }; then
        echo "❌ Error: Bash version $BASH_MAJOR.$BASH_MINOR is too old (requires 4.3+)"
        echo "   Current: $BASH_BIN --version => $BASH_VERSION_OUTPUT"
        echo ""
        echo "   Install newer bash:"
        echo "   - macOS: brew install bash"
        echo "   - Linux: check your package manager"
        echo ""
        echo "   Then ensure Homebrew bash is in PATH:"
        echo "   - Apple Silicon: /opt/homebrew/bin/bash"
        echo "   - Intel: /usr/local/bin/bash"
        exit 1
    fi
else
    echo "⚠️  Warning: Could not parse bash version from: $BASH_VERSION_OUTPUT"
    echo "   Cannot verify Bash version. Aborting to prevent potential failures."
    exit 1
fi

if ! $BASH_BIN ./scripts/clean-cache.sh > /dev/null 2>&1; then
    echo "⚠️  Warning: Cache cleanup script failed"
fi

# 2. Check if any cache files are staged
CACHE_FILES=$(git diff --cached --name-only | grep -E '(__pycache__|\.pyc$|\.pyo$|\.pyd$|\.pytest_cache/|\.mypy_cache/|\.ruff_cache/|\.hypothesis/)' || true)

if [ -n "$CACHE_FILES" ]; then
    echo "❌ Cache files detected in staged changes:"
    echo "$CACHE_FILES"
    echo ""
    echo "Please run: ./scripts/clean-cache.sh"
    echo "Then: git add . && git commit"
    exit 1
fi

# 3. Check for frontend changes and run tests
FRONTEND_CHANGES=$(git diff --cached --name-only | grep -E "^frontend/(src/|package\.json)" || true)

if [ -n "$FRONTEND_CHANGES" ]; then
    echo "🎨 Frontend changes detected, running tests..."

    # Check if we're in the right directory
    if [ ! -f "frontend/package.json" ]; then
        echo "⚠️  Warning: frontend/package.json not found, skipping frontend tests"
    else
        cd frontend

        # Run linting
        echo "🔍 Running ESLint..."
        if ! npm run lint --if-present; then
            echo "❌ ESLint failed. Please fix linting errors before committing."
            exit 1
        fi

        # Run type checking
        echo "🔍 Running TypeScript type check..."
        if ! npm run type-check --if-present; then
            echo "❌ TypeScript type check failed. Please fix type errors before committing."
            exit 1
        fi

        # Run tests for changed files
        echo "🧪 Running tests for changed files..."
        declare -a CHANGED_TEST_FILES=()
        while IFS= read -r file; do
            # Consider only TS/TSX under frontend/src/
            if [[ $file =~ ^frontend/src/(.+)\.(ts|tsx)$ ]]; then
                rel="${BASH_REMATCH[1]}"   # path without extension, may include ".test"
                ext="${BASH_REMATCH[2]}"
                # If the changed file is a test, run it; otherwise, map to its sibling test file.
                if [[ "$rel" == *.test ]]; then
                    test_file="src/${rel}.${ext}"
                else
                    test_file="src/${rel}.test.${ext}"
                fi
                if [ -f "$test_file" ]; then
                    CHANGED_TEST_FILES+=("$test_file")
                fi
            fi
        done <<< "$FRONTEND_CHANGES"

        # Run specific tests if any, otherwise run all tests
        if [ ${#CHANGED_TEST_FILES[@]} -gt 0 ]; then
            echo "Running tests for: ${CHANGED_TEST_FILES[*]}"
            if ! npm run test --if-present -- --run "${CHANGED_TEST_FILES[@]}"; then
                echo "❌ Tests failed. Please fix failing tests before committing."
                exit 1
            fi
        else
            echo "Running all tests..."
            if ! npm run test --if-present -- --run; then
                echo "❌ Tests failed. Please fix failing tests before committing."
                exit 1
            fi
        fi

        cd ..
    fi
fi

# 4. Check for Python changes and run basic checks
PYTHON_CHANGES=$(git diff --cached --name-only | grep "\.py$" || true)

if [ -n "$PYTHON_CHANGES" ]; then
    echo "🐍 Python changes detected, running basic checks..."

    # Auto-format with Black (project standard)
    echo "🎨 Auto-formatting Python code with Black..."
    if command -v black > /dev/null 2>&1; then
        # Filter to only existing files
        EXISTING_PY_FILES=()
        while IFS= read -r f; do
            [ -f "$f" ] && EXISTING_PY_FILES+=("$f")
        done <<< "$PYTHON_CHANGES"
        if [ ${#EXISTING_PY_FILES[@]} -gt 0 ]; then
            # Use --check with --diff to show what will be changed
            if ! black --check --diff "${EXISTING_PY_FILES[@]}" 2>/dev/null; then
                echo "⚠️  Black would reformat the following files (diff shown above)"
                # Apply formatting
                if black "${EXISTING_PY_FILES[@]}"; then
                    echo "✅ Black formatting applied. Files re-staged."
                    git add "${EXISTING_PY_FILES[@]}"
                    echo "⚠️  Black reformatted files. Review changes and re-commit."
                    exit 1
                else
                    echo "⚠️  Warning: Black formatting failed, continuing..."
                fi
            else
                echo "✅ Black formatting check passed (no changes needed)"
            fi
        fi
    else
        echo "⚠️  Warning: Black not found, skipping auto-formatting"
        echo "   Install with: pip install black"
    fi

    # Check Python syntax
    while IFS= read -r file; do
        if [ -f "$file" ]; then
            echo "Checking syntax: $file"
            if ! python -m py_compile "$file"; then
                echo "❌ Python syntax error in $file"
                exit 1
            fi
        fi
    done <<< "$PYTHON_CHANGES"

    # Run backend tests for changed Python files
    echo "🧪 Running backend tests for changed files..."
    if [ "${SKIP_TESTS:-0}" = "1" ]; then
        echo "⏩ SKIP_TESTS=1 set, skipping backend tests"
    elif command -v pytest > /dev/null 2>&1; then
        # Extract test files that correspond to changed Python files
        declare -a TEST_FILES=()
        while IFS= read -r file; do
            # Per-file test discovery: reset for each changed file
            declare -a FOUND_FOR_FILE=()

            # If the file is in tests/ directory (any depth), add it directly
            if [[ $file == tests/* ]] && [[ $file == *.py ]]; then
                [ -f "$file" ] && FOUND_FOR_FILE+=("$file")
            # Otherwise, check if corresponding test file exists
            # Extract basename to properly detect test files regardless of path
            elif [[ $file == *.py ]] && [[ ! $(basename "$file") == test_*.py ]]; then
                # Try to find test file in tests/ directory
                basename=$(basename "$file" .py)
                dirname=$(dirname "$file")

                # Normalize dirname (strip leading ./ if present)
                dirname=${dirname#./}

                # Common test file patterns
                test_patterns=(
                    "tests/test_${basename}.py"
                    "tests/${dirname}/test_${basename}.py"
                    "${dirname}/test_${basename}.py"
                )

                for pattern in "${test_patterns[@]}"; do
                    [ -f "$pattern" ] && FOUND_FOR_FILE+=("$pattern") && break
                done

                # Fallback: search recursively only if no test files were found for this file
                if [ ${#FOUND_FOR_FILE[@]} -eq 0 ]; then
                    # Use find to locate test files matching basename in tests/ tree
                    # -name matches basename only, but find searches recursively through all subdirs
                    while IFS= read -r test_file; do
                        [ -f "$test_file" ] && FOUND_FOR_FILE+=("$test_file")
                    done < <(find tests -type f -name "test_${basename}.py" 2>/dev/null)
                fi
            fi

            # Append per-file results to global TEST_FILES array
            TEST_FILES+=("${FOUND_FOR_FILE[@]}")
        done <<< "$PYTHON_CHANGES"

        if [ ${#TEST_FILES[@]} -gt 0 ]; then
            # Deduplicate test files to avoid running the same test multiple times
            mapfile -t TEST_FILES < <(printf '%s\n' "${TEST_FILES[@]}" | sort -u)
            echo "Running tests: ${TEST_FILES[*]}"
            if ! pytest -q "${TEST_FILES[@]}" --tb=short -x; then
                echo "❌ Backend tests failed. Please fix failing tests before committing."
                exit 1
            fi
            echo "✅ Backend tests passed"
        else
            echo "ℹ️  No corresponding test files found for changed Python files"
        fi
    else
        echo "⚠️  Warning: pytest not found, skipping backend tests"
    fi
fi

# 5. Run pre-commit framework hooks (MyPy, Bandit, etc.)
echo "🔧 Running pre-commit framework checks..."
if command -v pre-commit > /dev/null 2>&1; then
    # Temporarily unset hooksPath to prevent recursion
    ORIGINAL_HOOKS_PATH=""
    ORIGINAL_HOOKS_PATH_SET=0
    if git config --get core.hooksPath > /dev/null 2>&1; then
        ORIGINAL_HOOKS_PATH=$(git config --get core.hooksPath 2>/dev/null || echo "")
        ORIGINAL_HOOKS_PATH_SET=1
        git config --unset-all core.hooksPath || true
        # Only restore if core.hooksPath was actually set (even to an empty value)
        trap '[ "$ORIGINAL_HOOKS_PATH_SET" -eq 1 ] && git config core.hooksPath "$ORIGINAL_HOOKS_PATH"' EXIT
    fi
    # Safely handle filenames with spaces by using array
    mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACM)
    if [ ${#STAGED_FILES[@]} -gt 0 ]; then
        if ! pre-commit run --files "${STAGED_FILES[@]}" 2>&1; then
            echo "❌ Pre-commit checks failed (see above)"
            echo "ℹ️  If only formatting was fixed, re-add files and commit again."
            exit 1
        fi
    fi
else
    echo "⚠️  Warning: pre-commit not installed"
    echo "   Install with: pip install pre-commit && pre-commit install"
fi

echo "✅ All pre-commit checks completed!"
exit 0
