#!/usr/bin/env bash

# Pre-commit hook to run lightweight smoke tests before committing.
# To enable: git config core.hooksPath .githooks

set -euo pipefail

if [[ "${SKIP_PRECOMMIT_TESTS:-0}" == "1" ]]; then
  echo "⚠️  SKIP_PRECOMMIT_TESTS=1 set, skipping pre-commit smoke tests."
  exit 0
fi

if [[ "${CI:-}" == "true" ]]; then
  exit 0
fi

exec scripts/precommit_smoke.sh
