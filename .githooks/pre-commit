#!/bin/bash

# Pre-commit hook to clean cache files
echo "🧹 Running pre-commit cache cleanup..."

# Clean Python cache files
if ! ./scripts/clean-cache.sh >/dev/null 2>&1; then
    echo "⚠️  Warning: Cache cleanup script failed"
fi

# Check if any cache files are staged
CACHE_FILES=$(git diff --cached --name-only | grep -E '(__pycache__|\.pyc$|\.pyo$|\.pyd$)')

if [ ! -z "$CACHE_FILES" ]; then
    echo "❌ Cache files detected in staged changes:"
    echo "$CACHE_FILES"
    echo ""
    echo "Please run: ./scripts/clean-cache.sh"
    echo "Then: git add . && git commit"
    exit 1
fi

echo "✅ No cache files detected in staged changes"
exit 0
